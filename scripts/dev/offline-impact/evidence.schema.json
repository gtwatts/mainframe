{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe.dev/schemas/offline-agent-mechanism-evidence-v1.json",
  "title": "MAINFRAME offline agent mechanism evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "claim_scope",
    "protocol",
    "runtime",
    "execution",
    "rows",
    "summary",
    "result",
    "non_claims",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "mainframe-offline-agent-mechanism-evidence" },
    "claim_scope": { "const": "deterministic-policy-classification-fixtures-only" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "schema", "implementation"],
      "properties": {
        "fixture": { "$ref": "#/$defs/file_digest" },
        "schema": { "$ref": "#/$defs/file_digest" },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest_sha256", "files"],
          "properties": {
            "digest_sha256": { "$ref": "#/$defs/sha256" },
            "files": {
              "type": "array",
              "minItems": 3,
              "maxItems": 8,
              "items": { "$ref": "#/$defs/file_digest" }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "version",
        "evaluated_source_digest_sha256",
        "evaluated_source_files",
        "archive",
        "bash",
        "platform"
      ],
      "properties": {
        "origin": {
          "enum": ["source-tree", "release-archive"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
        },
        "evaluated_source_digest_sha256": { "$ref": "#/$defs/sha256" },
        "evaluated_source_files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/file_digest" }
        },
        "archive": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path_basename",
                "sha256",
                "checksum_sidecar_basename",
                "checksum_verified"
              ],
              "properties": {
                "path_basename": {
                  "type": "string",
                  "pattern": "^[^/]+\\.tar\\.gz$"
                },
                "sha256": { "$ref": "#/$defs/sha256" },
                "checksum_sidecar_basename": {
                  "type": "string",
                  "pattern": "^[^/]+\\.tar\\.gz\\.sha256$"
                },
                "checksum_verified": { "const": true }
              }
            }
          ]
        },
        "bash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable_basename", "version_line"],
          "properties": {
            "executable_basename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]{1,128}$"
            },
            "version_line": {
              "type": "string",
              "pattern": "^GNU bash, version ([4-9]|[1-9][0-9]+)\\."
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "release", "machine"],
          "properties": {
            "system": { "type": "string", "minLength": 1, "maxLength": 128 },
            "release": { "type": "string", "minLength": 1, "maxLength": 256 },
            "machine": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classifier_function",
        "block_tier",
        "commands_executed",
        "case_count"
      ],
      "properties": {
        "classifier_function": { "const": "agent_gate_classify" },
        "block_tier": { "const": "high" },
        "commands_executed": { "const": false },
        "case_count": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/result_row" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "exact_match_count",
        "mismatch_count",
        "expected_block_count",
        "observed_block_count",
        "fixture_false_positive_count",
        "fixture_false_negative_count"
      ],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "exact_match_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "mismatch_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "expected_block_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "observed_block_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "fixture_false_positive_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "fixture_false_negative_count": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "result": { "enum": ["pass", "fail"] },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_provider_inference",
        "agent_quality",
        "productivity",
        "comparative_agent_performance",
        "live_agent_sessions"
      ],
      "properties": {
        "real_provider_inference": { "const": "not-run" },
        "agent_quality": { "const": "not-measured" },
        "productivity": { "const": "not-measured" },
        "comparative_agent_performance": { "const": "not-measured" },
        "live_agent_sessions": { "const": 0 }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_fixture_corpus",
        "policy_classification_only",
        "command_execution_prevention",
        "os_sandbox_containment",
        "generalization_beyond_fixtures"
      ],
      "properties": {
        "synthetic_fixture_corpus": { "const": true },
        "policy_classification_only": { "const": true },
        "command_execution_prevention": { "const": "not-tested" },
        "os_sandbox_containment": { "const": "not-tested" },
        "generalization_beyond_fixtures": { "const": "not-established" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "rule", "blocked"],
      "properties": {
        "risk": { "enum": ["critical", "high", "medium", "low"] },
        "rule": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "blocked": { "type": "boolean" }
      }
    },
    "result_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "expected",
        "observed",
        "exact_match",
        "executed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expected": { "$ref": "#/$defs/classification" },
        "observed": { "$ref": "#/$defs/classification" },
        "exact_match": { "type": "boolean" },
        "executed": { "const": false }
      }
    }
  }
}
