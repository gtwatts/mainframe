{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gtwatts/mainframe/schemas/agent-impact-suite-v1.json",
  "title": "MAINFRAME Agent Impact Protocol suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "description", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "mainframe-agent-impact-suite" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tasks/[a-z0-9][a-z0-9-]*/task\\.json$"
      }
    }
  }
}
