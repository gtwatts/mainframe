{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gtwatts/mainframe/schemas/agent-impact-pi-ollama-adapter-request-v1.json",
  "title": "MAINFRAME neutral Pi and Ollama adapter request",
  "$comment": "The preflight applies recursive, case-sensitive, exact-key rejection for arm_mode, assignment, control, mechanism, treatment and recursive exact-string rejection for control, mainframe-awm-handoff, native-bounded-handoff, treatment to every request-facing contract value before admitting this schema. Substrings such as control-plane remain permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "study_id", "pair_id", "opaque_arm_id", "task_id", "phase", "workspace", "prompt_path", "context_path", "artifact_dir", "result_path", "provider", "budgets", "environment_contract"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "mainframe-agent-impact-pi-ollama-adapter-request" },
    "study_id": { "$ref": "#/$defs/id" },
    "pair_id": { "type": "string", "pattern": "^pair-[0-9a-f]{16}$" },
    "opaque_arm_id": { "type": "string", "pattern": "^arm-[0-9a-f]{16}$" },
    "task_id": { "$ref": "#/$defs/id" },
    "phase": { "enum": ["investigate", "implement"] },
    "workspace": { "$ref": "#/$defs/absolutePath" },
    "prompt_path": { "$ref": "#/$defs/absolutePath" },
    "context_path": { "oneOf": [{ "$ref": "#/$defs/absolutePath" }, { "type": "null" }] },
    "artifact_dir": { "$ref": "#/$defs/absolutePath" },
    "result_path": { "$ref": "#/$defs/absolutePath" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "runtime_binding_sha256"],
      "properties": {
        "name": { "const": "ollama" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "enum": ["control", "mainframe-awm-handoff", "native-bounded-handoff", "treatment"] } },
        "runtime_binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "maximum_tool_calls", "maximum_context_bytes"],
      "properties": {
        "wall_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximum_tool_calls": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maximum_context_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "environment_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_per_phase", "allowed_environment_names"],
      "properties": {
        "fresh_per_phase": { "const": true },
        "allowed_environment_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$", "not": { "enum": ["control", "mainframe-awm-handoff", "native-bounded-handoff", "treatment"] } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/(?!.*//)(?!.*(?:/\\.\\.?)(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/[^/\\u0000-\\u001f\\u007f]+)*$", "maxLength": 4096 }
  }
}
