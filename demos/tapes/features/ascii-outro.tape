Output demos/gifs/features/ascii-outro.gif

Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 600
Set TypingSpeed 0ms
Set Theme { "background": "#1e1e2e", "foreground": "#cdd6f4" }

Hide
Type "clear"
Enter
Show
Sleep 300ms

Type@0ms "cat << 'BANNER'"
Enter
Type@0ms ""
Enter
Type@0ms "  +======================================================================+"
Enter
Type@0ms "  |  __  __    _    ___ _   _ _____ ____      _    __  __ _____          |"
Enter
Type@0ms "  | |  \/  |  / \  |_ _| \ | |  ___|  _ \    / \  |  \/  | ____|         |"
Enter
Type@0ms "  | | |\/| | / _ \  | ||  \| | |_  | |_) |  / _ \ | |\/| |  _|           |"
Enter
Type@0ms "  | | |  | |/ ___ \ | || |\  |  _| |  _ <  / ___ \| |  | | |___          |"
Enter
Type@0ms "  | |_|  |_/_/   \_\___|_| \_|_|   |_| \_\/_/   \_\_|  |_|_____|         |"
Enter
Type@0ms "  |                                                                      |"
Enter
Type@0ms "  |               AI-Native Bash Runtime  v5.0                           |"
Enter
Type@0ms "  |                                                                      |"
Enter
Type@0ms "  |     77 libraries  |  1,900+ functions  |  Zero dependencies          |"
Enter
Type@0ms "  |                                                                      |"
Enter
Type@0ms "  +======================================================================+"
Enter
Type@0ms ""
Enter
Type@0ms "BANNER"
Enter
Sleep 1s

Type ""
Enter
Type "echo ''"
Enter
Type "echo '               github.com/gtwatts/mainframe'"
Enter
Type "echo ''"
Enter
Sleep 5s
