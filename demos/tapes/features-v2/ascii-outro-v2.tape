Output demos/gifs/features-v2/ascii-outro.gif
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set Width 1000
Set Height 500
Set TypingSpeed 0ms
Set Padding 30
Set Theme {
    "background": "#0d1117",
    "foreground": "#c9d1d9",
    "green": "#3fb950",
    "red": "#f85149",
    "yellow": "#d29922",
    "cyan": "#58a6ff"
}

Hide
Type "clear"
Enter
Show
Sleep 500ms

# Display ASCII art instantly
Type 'cat << "EOF"'
Enter
Type ""
Enter
Type "+======================================================================+"
Enter
Type "|  __  __    _    ___ _   _ _____ ____      _    __  __ _____          |"
Enter
Type "| |  \\/  |  / \\  |_ _| \\ | |  ___|  _ \\    / \\  |  \\/  | ____|         |"
Enter
Type "| | |\\/| | / _ \\  | ||  \\| | |_  | |_) |  / _ \\ | |\\/| |  _|           |"
Enter
Type "| | |  | |/ ___ \\ | || |\\  |  _| |  _ <  / ___ \\| |  | | |___          |"
Enter
Type "| |_|  |_/_/   \\_\\___|_| \\_|_|   |_| \\_\\/_/   \\_\\_|  |_|_____|         |"
Enter
Type "|                                                                      |"
Enter
Type "|     AI agents control computers through bash.                        |"
Enter
Type "|     MAINFRAME makes that safe, accurate, and efficient.              |"
Enter
Type "+======================================================================+"
Enter
Type ""
Enter
Type "                  github.com/gtwatts/mainframe"
Enter
Type ""
Enter
Type "EOF"
Enter
Sleep 6s
