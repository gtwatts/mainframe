#!/bin/bash -p
# =============================================================================
# MAINFRAME CLI
# =============================================================================
# Provides: mainframe <command> [args]
#
# Commands:
#   version     Show MAINFRAME version
#   functions   List all available functions
#   invoke      Invoke one reviewed canonical manifest export
#   code        Durable workspace read, search, and approval-gated actions
#   help        Show detailed help for a specific function
#   search      Search functions by name or description
#   awm         Agent Working Memory lifecycle, retrieval, and handoff tools
#   work        Build a read-only task brief from existing project memory
#   quickref    Show compact function signatures (with --search for lookup)
#   fzf         Interactive fuzzy finder for functions (requires fzf)
#   explore     TUI browser for functions (requires dialog/whiptail)
#   build       Build static binaries, bundles, or containers
#   benchmark   Run performance benchmarks
#   test        Run test suite
#   doctor      Check MAINFRAME installation
#   shell       Inspect or repair Bash/zsh integration identity
#   agent-hook  Enforce shell-command policy as an AI host pre-tool hook
#   protect     Inspect project enforcement readiness
#   host        Inspect or manage private coding-agent host runtimes
#   pi          Diagnose, install, or remove the native Pi package integration
#   control-plane  Operate the durable run/approval/evidence kernel
#   claim       Verify the evidence-bound control-plane promotion claim
#   setup       Discover shells/hosts or explicitly onboard one host
#   onboard     Preview, consent to, and verify one protected host setup
#   launch      Preflight and start one onboarded coding-agent host
#   update      Update MAINFRAME (if installed via git)
#   upgrade     Install an explicitly selected verified release archive
#   release     Report offline release readiness without claiming remote proof
#   uninstall   Run the installation-owned recoverable uninstaller
# =============================================================================

# An explicit unprivileged `bash bin/mainframe` can import functions whose
# names shadow even launch primitives such as `set` and `builtin`. Enter the
# fixed protected system Bash before executing any command in that process;
# the protected Bash 3.2-compatible bootstrap below then selects Bash 4.4+.
case "$-" in
    *p*)

set -euo pipefail

# A protected launch may begin in a shell whose environment was shaped by the
# project (for example through direnv). The interpreter for this file has
# already started, so this cannot protect that initial process; it does ensure
# that every later launch helper, bootstrap interpreter, and host process does
# not inherit passive language-runtime or dynamic-loader injection hooks.
# Keep this bootstrap compatible with Apple's Bash 3.2.
_mainframe_cli_scrub_launch_code_loader_env() {
    local function_name variable prefix

    builtin unset -v BASHOPTS SHELLOPTS 2>/dev/null || true
    builtin unset -v \
        BASH_ENV BASH_LOADABLES_PATH BASH_XTRACEFD CDPATH ENV GLOBIGNORE \
        NODE_OPTIONS NODE_PATH NODE_V8_COVERAGE NODE_REPL_HISTORY \
        NODE_REDIRECT_WARNINGS \
        PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONINSPECT \
        PYTHONWARNINGS PYTHONBREAKPOINT PYTHONUSERBASE PYTHONHASHSEED \
        PERL5OPT PERL5LIB PERLLIB RUBYOPT RUBYLIB 2>/dev/null || return 1

    for prefix in LD_ DYLD_; do
        while IFS= read -r variable; do
            builtin unset -v "$variable" 2>/dev/null || return 1
        done < <(builtin compgen -A variable "$prefix")
    done
    while IFS= read -r function_name; do
        if [[ "$function_name" == _mainframe_cli_scrub_launch_code_loader_env ]]; then
            # shellcheck disable=SC2163 # The dynamic function name is intentional.
            builtin export -n -f "$function_name" 2>/dev/null || return 1
        else
            builtin unset -f "$function_name" 2>/dev/null || return 1
        fi
    done < <(builtin compgen -A function)
}

_mainframe_cli_scrub_launch_code_loader_env || {
    printf 'MAINFRAME could not clear inherited code-loader environment.\n' >&2
    exit 1
}
unset -f _mainframe_cli_scrub_launch_code_loader_env

if [[ -n "${MAINFRAME_BASH:-}" && "$MAINFRAME_BASH" != /* ]]; then
    printf 'MAINFRAME_BASH must be an absolute reviewed Bash path; PATH names and relative paths are never executed.\n' >&2
    exit 1
fi

# macOS login shells can let /etc/zprofile's path_helper place /usr/bin before
# Homebrew, even when installation itself selected a supported Bash. Keep the
# public launcher runnable under Apple's Bash 3.2 long enough to locate and
# re-exec a verified Bash 4.4+; the runtime and gateway remain 4.4+ only.
_mainframe_cli_bash_supported() {
    local candidate="${1:-}"
    [[ -x "$candidate" ]] || return 1
    "$candidate" --noprofile --norc -p -c '
        (( BASH_VERSINFO[0] > 4 )) ||
        (( BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4 ))
    ' >/dev/null 2>&1
}

# Resolve a candidate with fixed readlink paths before executing it. This
# helper stays compatible with Apple's Bash 3.2 because it runs before the
# supported-interpreter re-exec.
_mainframe_cli_resolve_executable() {
    local source="${1:-}" dir target links=0
    [[ "$source" == /* ]] || return 1
    while [[ -L "$source" ]]; do
        (( links < 40 )) || return 1
        links=$((links + 1))
        dir="${source%/*}"
        [[ -n "$dir" ]] || dir=/
        dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
        if [[ -x /usr/bin/readlink ]]; then
            target="$(/usr/bin/readlink "$source")" || return 1
        elif [[ -x /bin/readlink ]]; then
            target="$(/bin/readlink "$source")" || return 1
        else
            return 1
        fi
        [[ "$target" == /* ]] && source="$target" || source="$dir/$target"
    done
    dir="${source%/*}"
    [[ -n "$dir" ]] || dir=/
    dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
    source="$dir/${source##*/}"
    [[ -f "$source" && -x "$source" ]] || return 1
    [[ "$source" != *$'\n'* && "$source" != *$'\r'* &&
       "$source" != *$'\t'* ]] || return 1
    printf '%s\n' "$source"
}

# A protected launch under Apple's Bash 3.2 must not probe an ambient
# project/direnv PATH entry by executing it as Bash. Only standard system and
# package-manager layouts may bootstrap the launch command.
_mainframe_cli_bash_allowed_for_launch() {
    case "${1:-}" in
        /usr/bin/bash|/bin/bash|/usr/local/bin/bash|\
        /opt/local/bin/bash|\
        /opt/homebrew/Cellar/*/bin/bash|/usr/local/Cellar/*/bin/bash|\
        /home/linuxbrew/.linuxbrew/Cellar/*/bin/bash|/nix/store/*/bin/bash)
            return 0
            ;;
        *) return 1 ;;
    esac
}

# MAINFRAME_BASH is an execution identity, not merely a fallback.  When it is
# explicitly configured, enter that exact reviewed Bash even if the shebang or
# caller already provided a different supported Bash (notably Linux /bin/bash).
if [[ -n "${MAINFRAME_BASH:-}" ]]; then
    _mainframe_cli_resolved="$(_mainframe_cli_resolve_executable \
        "$MAINFRAME_BASH" 2>/dev/null || true)"
    _mainframe_cli_active="$(_mainframe_cli_resolve_executable \
        "${BASH:-}" 2>/dev/null || true)"
    if [[ -z "$_mainframe_cli_resolved" ]] ||
       ! _mainframe_cli_bash_allowed_for_launch "$_mainframe_cli_resolved" ||
       ! _mainframe_cli_bash_supported "$_mainframe_cli_resolved"; then
        printf 'MAINFRAME_BASH must resolve to a supported reviewed Bash 4.4+ installation.\n' >&2
        exit 1
    fi
    if [[ -z "$_mainframe_cli_active" ||
          "$_mainframe_cli_active" != "$_mainframe_cli_resolved" ]]; then
        exec "$_mainframe_cli_resolved" --noprofile --norc -p "$0" "$@"
    fi
fi

if (( BASH_VERSINFO[0] < 4 )) || \
   (( BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4 )); then
    _mainframe_cli_candidate=""
    _mainframe_cli_resolved=""
    if [[ -n "${MAINFRAME_BASH:-}" ]]; then
        _mainframe_cli_resolved="$(_mainframe_cli_resolve_executable \
            "$MAINFRAME_BASH" 2>/dev/null || true)"
        if [[ -z "$_mainframe_cli_resolved" ]] ||
           ! _mainframe_cli_bash_allowed_for_launch "$_mainframe_cli_resolved" ||
           ! _mainframe_cli_bash_supported "$_mainframe_cli_resolved"; then
            printf 'MAINFRAME_BASH must resolve to a supported reviewed Bash 4.4+ installation.\n' >&2
            exit 1
        fi
        exec "$_mainframe_cli_resolved" --noprofile --norc -p "$0" "$@"
    fi
    for _mainframe_cli_candidate in \
        /opt/homebrew/bin/bash \
        /usr/local/bin/bash \
        /home/linuxbrew/.linuxbrew/bin/bash \
        /opt/local/bin/bash \
        /usr/bin/bash \
        /bin/bash; do
        [[ -n "$_mainframe_cli_candidate" ]] || continue
        _mainframe_cli_resolved="$(_mainframe_cli_resolve_executable \
            "$_mainframe_cli_candidate" 2>/dev/null || true)"
        [[ -n "$_mainframe_cli_resolved" ]] || continue
        if ! _mainframe_cli_bash_allowed_for_launch "$_mainframe_cli_resolved"; then
            continue
        fi
        if _mainframe_cli_bash_supported "$_mainframe_cli_resolved"; then
            exec "$_mainframe_cli_resolved" --noprofile --norc -p "$0" "$@"
        fi
    done

    printf 'MAINFRAME requires Bash 4.4+ at a supported fixed installation; set MAINFRAME_BASH to an absolute reviewed path (found %s).\n' \
        "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Direct execution enters through the privileged shebang above. Explicit
# `bash bin/mainframe ...` invocations are normalized here so BASH_ENV and
# exported shell functions cannot influence the CLI after this bootstrap.
case "$-" in
    *p*) ;;
    *)
        _mainframe_cli_resolved="$(_mainframe_cli_resolve_executable \
            "${BASH:-}" 2>/dev/null || true)"
        [[ -n "$_mainframe_cli_resolved" ]] || {
            printf 'MAINFRAME could not canonicalize the active Bash before protected re-entry.\n' >&2
            exit 1
        }
        exec "$_mainframe_cli_resolved" --noprofile --norc -p "$0" "$@"
        ;;
esac
unset -f _mainframe_cli_bash_supported
unset -f _mainframe_cli_bash_allowed_for_launch
unset -f _mainframe_cli_scrub_launch_code_loader_env
unset _mainframe_cli_candidate _mainframe_cli_resolved _mainframe_cli_active

# Determine MAINFRAME root directory, including when this executable is reached
# through the installer-created symlink in ~/.local/bin.
_MAINFRAME_CLI_INHERITED_ROOT="${MAINFRAME_ROOT:-}"
CLI_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$CLI_SOURCE" ]]; do
    CLI_DIR="${CLI_SOURCE%/*}"
    [[ "$CLI_DIR" != "$CLI_SOURCE" ]] || CLI_DIR=.
    CLI_DIR="$(cd -- "$CLI_DIR" 2>/dev/null && pwd -P)" || exit 1
    if [[ -x /usr/bin/readlink ]]; then
        CLI_SOURCE="$(/usr/bin/readlink "$CLI_SOURCE")" || exit 1
    elif [[ -x /bin/readlink ]]; then
        CLI_SOURCE="$(/bin/readlink "$CLI_SOURCE")" || exit 1
    else
        exit 1
    fi
    [[ "$CLI_SOURCE" == /* ]] || CLI_SOURCE="$CLI_DIR/$CLI_SOURCE"
done
CLI_DIR="${CLI_SOURCE%/*}"
[[ "$CLI_DIR" != "$CLI_SOURCE" ]] || CLI_DIR=.
SCRIPT_DIR="$(cd -- "$CLI_DIR/.." 2>/dev/null && pwd -P)" || exit 1
export MAINFRAME_ROOT="$SCRIPT_DIR"

# The structured control-plane kernel is a narrow stdlib-Python path and does
# not depend on the broad Bash library surface. Dispatch it before common.sh so
# policy and ledger inspection remain available even when the optional runtime
# closure is unavailable.
if [[ "${1:-}" == "control-plane" ]]; then
    shift
    [[ -f "$MAINFRAME_ROOT/control_plane/mainframe-control-plane" &&
       -x "$MAINFRAME_ROOT/control_plane/mainframe-control-plane" ]] || {
        printf '{"ok":false,"command":null,"error":{"code":"configuration_error","message":"control-plane launcher is missing or not executable"}}\n' >&2
        exit 78
    }
    exec "$MAINFRAME_ROOT/control_plane/mainframe-control-plane" "$@"
fi

# Agent hooks run synchronously before every shell tool call. Dispatch this
# narrow path before loading the general runtime to minimize latency and the
# amount of code inside the enforcement boundary.
case "${1:-}" in
    agent-hook|agent-gateway)
        shift
        _mainframe_cli_jq_source="$(type -P jq 2>/dev/null || true)"
        _mainframe_cli_jq_links=0
        while [[ -L "$_mainframe_cli_jq_source" ]]; do
            (( _mainframe_cli_jq_links < 40 )) || {
                echo "MAINFRAME agent gateway failed: jq symlink traversal exceeded its limit" >&2
                exit 2
            }
            _mainframe_cli_jq_links=$((_mainframe_cli_jq_links + 1))
            _mainframe_cli_jq_dir="${_mainframe_cli_jq_source%/*}"
            _mainframe_cli_jq_dir="$(cd -- "$_mainframe_cli_jq_dir" 2>/dev/null && pwd -P)" || exit 2
            if [[ -x /usr/bin/readlink ]]; then
                _mainframe_cli_jq_target="$(/usr/bin/readlink "$_mainframe_cli_jq_source")" || exit 2
            elif [[ -x /bin/readlink ]]; then
                _mainframe_cli_jq_target="$(/bin/readlink "$_mainframe_cli_jq_source")" || exit 2
            else
                exit 2
            fi
            if [[ "$_mainframe_cli_jq_target" == /* ]]; then
                _mainframe_cli_jq_source="$_mainframe_cli_jq_target"
            else
                _mainframe_cli_jq_source="$_mainframe_cli_jq_dir/$_mainframe_cli_jq_target"
            fi
        done
        _mainframe_cli_jq_dir="${_mainframe_cli_jq_source%/*}"
        _mainframe_cli_jq_dir="$(cd -- "$_mainframe_cli_jq_dir" 2>/dev/null && pwd -P)" || exit 2
        _mainframe_cli_jq_source="$_mainframe_cli_jq_dir/${_mainframe_cli_jq_source##*/}"
        [[ -f "$_mainframe_cli_jq_source" && ! -L "$_mainframe_cli_jq_source" &&
           -x "$_mainframe_cli_jq_source" ]] || {
            echo "MAINFRAME agent gateway failed: jq is missing or unsafe" >&2
            exit 2
        }
        case "$_mainframe_cli_jq_source" in
            /usr/bin/jq|/bin/jq|/usr/local/bin/jq|/opt/local/bin/jq|\
            /opt/homebrew/Cellar/*/bin/jq|/usr/local/Cellar/*/bin/jq|\
            /home/linuxbrew/.linuxbrew/Cellar/*/bin/jq|/nix/store/*/bin/jq) ;;
            *)
                echo "MAINFRAME agent gateway failed: jq is outside a supported installation" >&2
                exit 2
                ;;
        esac
        _mainframe_cli_safety="$MAINFRAME_ROOT/lib/agent_safety.sh"
        [[ "$_mainframe_cli_safety" == /* &&
           -f "$_mainframe_cli_safety" && ! -L "$_mainframe_cli_safety" &&
           -r "$_mainframe_cli_safety" ]] || {
            echo "MAINFRAME agent gateway failed: safety policy is missing or unsafe" >&2
            exit 2
        }
        # Invoke with the already-verified interpreter. A direct shebang
        # launch could fall back to Apple's Bash 3.2 after zsh path_helper.
        if MAINFRAME_AGENT_JQ="$_mainframe_cli_jq_source" \
           MAINFRAME_AGENT_SAFETY="$_mainframe_cli_safety" \
           "$BASH" --noprofile --norc -p \
           "$MAINFRAME_ROOT/hooks/agent-gateway.sh" "$@"; then
            exit 0
        else
            hook_status=$?
            [[ "$hook_status" -eq 2 ]] || \
                echo "MAINFRAME agent gateway failed (exit=$hook_status); denying tool call" >&2
            exit 2
        fi
        ;;
esac

# The caller's PATH is untrusted process input. Preserve it only as data for
# commands whose dedicated resolvers authenticate host/runtime dependencies,
# then establish a fixed helper PATH before common.sh executes even one tool.
# This keeps project-local tr/git/jq/hash shims outside every CLI initialization
# and every lifecycle command. A few explicitly tool-oriented commands restore
# the caller PATH only after common initialization has completed.
_mainframe_cli_caller_path="${PATH:-}"
_MAINFRAME_CLI_CALLER_PATH="$_mainframe_cli_caller_path"
_mainframe_cli_restore_caller_path=false
case "${1:-}" in
    launch)
        export _MAINFRAME_LAUNCH_DISCOVERY_PATH="$_mainframe_cli_caller_path"
        ;;
    host)
        export _MAINFRAME_HOST_DISCOVERY_PATH="$_mainframe_cli_caller_path"
        ;;
    setup)
        export _MAINFRAME_SETUP_DISCOVERY_PATH="$_mainframe_cli_caller_path"
        if [[ -z "${_MAINFRAME_AGENT_DISCOVERY_PATH+x}" ]]; then
            export _MAINFRAME_AGENT_DISCOVERY_PATH="$_mainframe_cli_caller_path"
        fi
        ;;
    pi)
        # Pi status/lifecycle never executes the discovered CLI. Preserve the
        # caller PATH only as data so `pi doctor` can identify the executable
        # the user's shell would select while the command itself stays on the
        # fixed helper PATH below.
        export _MAINFRAME_PI_DISCOVERY_PATH="$_mainframe_cli_caller_path"
        ;;
    onboard|activate|deactivate|protect)
        # Nested onboarding CLI calls inherit the original discovery value;
        # direct invocations capture their own caller PATH here.
        if [[ -z "${_MAINFRAME_AGENT_DISCOVERY_PATH+x}" ]]; then
            export _MAINFRAME_AGENT_DISCOVERY_PATH="$_mainframe_cli_caller_path"
        fi
        ;;
    run|benchmark|bench|test|tests|build|fzf|fuzzy|browse|explore|tui)
        _mainframe_cli_restore_caller_path=true
        ;;
esac

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
builtin hash -r

# Bind lifecycle dependencies by canonical absolute path. Package-manager
# locations remain supported without placing their neighboring executables on
# PATH, and source/release ownership checks never resolve ambient shims.
_mainframe_cli_tool_layout_is_known() {
    local tool="$1" candidate="$2" prefix remainder version store_entry

    case "$tool:$candidate" in
        jq:/bin/jq|jq:/usr/bin/jq|jq:/usr/local/bin/jq|jq:/opt/local/bin/jq)
            return 0
            ;;
        python3:/bin/python3|python3:/usr/bin/python3)
            return 0
            ;;
        git:/bin/git|git:/usr/bin/git|git:/opt/local/bin/git)
            return 0
            ;;
    esac

    # Linux's fixed /usr/bin/python3 is normally a symlink to python3.X.
    # Resolution happens before this check; accept only numeric versions in
    # the same system directories, retaining the ownership/mode checks below.
    if [[ "$tool" == "python3" &&
          "$candidate" =~ ^/(usr/)?bin/python3\.[0-9]+$ ]]; then
        return 0
    fi

    if [[ "$tool" == "jq" ]]; then
        case "$candidate" in
            /nix/store/*/bin/jq)
                remainder="${candidate#/nix/store/}"
                store_entry="${remainder%%/*}"
                [[ -n "$store_entry" && "$remainder" == "$store_entry/bin/jq" ]]
                return
                ;;
        esac
    fi

    for prefix in \
        "/opt/homebrew/Cellar/$tool/" \
        "/usr/local/Cellar/$tool/" \
        "/home/linuxbrew/.linuxbrew/Cellar/$tool/"; do
        case "$candidate" in
            "$prefix"*)
                remainder="${candidate#"$prefix"}"
                version="${remainder%%/*}"
                [[ -n "$version" && "$remainder" == "$version/bin/$tool" ]]
                return
                ;;
        esac
    done
    return 1
}

_mainframe_cli_owner_mode() {
    local path="$1" result owner mode
    if [[ -x /usr/bin/stat ]]; then
        result="$(/usr/bin/stat -c '%u %a' "$path" 2>/dev/null ||
            /usr/bin/stat -f '%u %Mp%Lp' "$path" 2>/dev/null)" || return 1
    elif [[ -x /bin/stat ]]; then
        result="$(/bin/stat -c '%u %a' "$path" 2>/dev/null ||
            /bin/stat -f '%u %Mp%Lp' "$path" 2>/dev/null)" || return 1
    else
        return 1
    fi
    [[ "$result" =~ ^[0-9]+\ [0-7]{3,4}$ ]] || return 1
    read -r owner mode <<< "$result"
    [[ ${#mode} -eq 4 && "$mode" == 0* ]] && mode="${mode#0}"
    printf '%s %s\n' "$owner" "$mode"
}

_mainframe_cli_trust_file_is_safe() {
    local path="$1" parent canonical_parent owner mode numeric

    [[ "$path" == /* && "$path" != */ &&
       "$path" != *$'\n'* && "$path" != *$'\r'* &&
       "$path" != *$'\t'* && -f "$path" && ! -L "$path" &&
       -r "$path" ]] || return 1
    parent="${path%/*}"
    [[ -n "$parent" ]] || parent=/
    canonical_parent="$(
        builtin cd -- "$parent" 2>/dev/null && builtin pwd -P
    )" || return 1
    [[ "$path" == "${canonical_parent%/}/${path##*/}" ]] || return 1

    read -r owner mode < <(_mainframe_cli_owner_mode "$path") || return 1
    [[ "$owner" =~ ^[0-9]+$ && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    [[ "$owner" -eq 0 || "$owner" -eq "$EUID" ]] || return 1
    numeric=$((8#$mode))
    (( (numeric & 0022) == 0 && (numeric & 07000) == 0 ))
}

_mainframe_cli_path_has_no_write_acl() {
    local path="$1" line listing permissions
    case "${OSTYPE:-}" in
        darwin*) ;;
        *) return 0 ;;
    esac
    [[ -x /bin/ls ]] || return 1
    listing="$(LC_ALL=C /bin/ls -lde "$path" 2>/dev/null)" || return 1
    while IFS= read -r line; do
        [[ "$line" == *' allow '* ]] || continue
        permissions=",${line#* allow },"
        case "$permissions" in
            *,write,*|*,append,*|*,delete,*|*,delete_child,*|\
            *,add_file,*|*,add_subdirectory,*|*,writeattr,*|\
            *,writeextattr,*|*,writeowner,*|*,writesecurity,*|*,chown,*)
                return 1
                ;;
        esac
    done <<< "$listing"
}

_mainframe_cli_find_trusted_tool() {
    local tool="$1" candidate resolved owner mode numeric
    local -a candidates=()

    case "$tool" in
        jq)
            candidates=(
                /usr/bin/jq /bin/jq /opt/homebrew/bin/jq /usr/local/bin/jq
                /home/linuxbrew/.linuxbrew/bin/jq /opt/local/bin/jq
            )
            ;;
        git)
            candidates=(
                /opt/homebrew/bin/git /usr/local/bin/git
                /home/linuxbrew/.linuxbrew/bin/git /opt/local/bin/git
                /usr/bin/git /bin/git
            )
            ;;
        python3)
            # The claim checker is stdlib-only. Keep this read-only verification
            # surface on an OS-owned interpreter rather than ambient PATH or a
            # package-manager environment.
            candidates=(/usr/bin/python3 /bin/python3)
            ;;
        *) return 1 ;;
    esac

    for candidate in "${candidates[@]}"; do
        resolved="$(_mainframe_cli_resolve_executable "$candidate" 2>/dev/null || true)"
        [[ -n "$resolved" ]] || continue
        _mainframe_cli_tool_layout_is_known "$tool" "$resolved" || continue
        read -r owner mode < <(_mainframe_cli_owner_mode "$resolved") || continue
        [[ "$owner" -eq 0 || "$owner" -eq "$EUID" ]] || continue
        numeric=$((8#$mode))
        (( (numeric & 0022) == 0 && (numeric & 07000) == 0 &&
           (numeric & 0100) != 0 )) || continue
        _mainframe_cli_path_has_no_write_acl "$resolved" || continue
        printf '%s\n' "$resolved"
        return 0
    done
    return 1
}

_MAINFRAME_CLI_JQ="$(_mainframe_cli_find_trusted_tool jq 2>/dev/null || true)"
readonly _MAINFRAME_CLI_JQ
_MAINFRAME_CLI_PYTHON="$(_mainframe_cli_find_trusted_tool python3 2>/dev/null || true)"
readonly _MAINFRAME_CLI_PYTHON

if [[ -n "$_MAINFRAME_CLI_JQ" ]]; then
    jq() {
        "$_MAINFRAME_CLI_JQ" "$@"
    }
fi

# Report the checked-in promotion contract through one fixed, read-only
# checker. The wrapper deliberately exposes no root/contract override and does
# not edit or promote the advertised claim.
if [[ "${1:-}" == "claim" ]]; then
    shift
    case "${1:-}" in
        "") _mainframe_cli_claim_args=() ;;
        --json) _mainframe_cli_claim_args=(--json); shift ;;
        -h|--help)
            printf 'Usage: mainframe claim [--json]\n'
            exit 0
            ;;
        *)
            printf 'Usage: mainframe claim [--json]\n' >&2
            exit 64
            ;;
    esac
    (( $# == 0 )) || {
        printf 'Usage: mainframe claim [--json]\n' >&2
        exit 64
    }
    _mainframe_cli_claim_checker="$MAINFRAME_ROOT/scripts/check-control-plane-claim.py"
    _mainframe_cli_claim_contract="$MAINFRAME_ROOT/config/control-plane-claim.json"
    [[ -n "$_MAINFRAME_CLI_PYTHON" ]] || {
        printf 'MAINFRAME claim check failed: trusted system Python is unavailable\n' >&2
        exit 69
    }
    if ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_claim_checker" ||
       ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_claim_contract"; then
        printf 'MAINFRAME claim check failed: canonical checker or contract is unsafe\n' >&2
        exit 126
    fi
    exec /usr/bin/env -i \
        HOME="${HOME:-}" \
        USER="${USER:-}" \
        LOGNAME="${LOGNAME:-}" \
        TMPDIR=/tmp \
        PATH=/usr/bin:/bin:/usr/sbin:/sbin \
        LC_ALL=C \
        "$_MAINFRAME_CLI_PYTHON" -I -S -B \
        "$_mainframe_cli_claim_checker" \
        --root "$MAINFRAME_ROOT" \
        --contract "$_mainframe_cli_claim_contract" \
        "${_mainframe_cli_claim_args[@]}"
fi

# The durable kernel's canonical executor reaches the reviewed broker through
# one fixed, non-public adapter grammar.  It accepts only the canonical ID and
# canonical JSON on stdin; executable paths, Bash function names, output modes,
# caller labels, evidence, and authority are not caller-selectable here.
if [[ "${1:-}" == "__kernel-stable-core-broker-v1" ]]; then
    shift
    if (( $# != 9 )) ||
       [[ "${2:-}" != "--input-json" || "${3:-}" != "-" ||
          "${4:-}" != "--profile" || "${5:-}" != "stable-core" ||
          "${6:-}" != "--format" || "${7:-}" != "broker-json-v1" ||
          "${8:-}" != "--caller" || "${9:-}" != "control-plane" ]]; then
        exit 64
    fi
    # The kernel executor alone reserves inherited FD 198 as an anonymous
    # liveness capability.  No argv or environment value can select it.  This
    # guardian starts before job control, so it remains in the adapter's fixed
    # process group and anchors that PGID against reuse.  Worker SIGKILL closes
    # the pipe: TERM lets the broker trap stop its separate function group,
    # then fixed-grace KILL removes anything left in the adapter group.
    [[ -p /dev/fd/198 ]] || exit 126
    (
        trap '' HUP TERM
        if IFS= read -r -n 1 _mainframe_liveness_byte <&198; then
            exit 0
        fi
        kill -TERM -- "-$$" 2>/dev/null || true
        /bin/sleep 0.25
        kill -KILL -- "-$$" 2>/dev/null || true
    ) </dev/null >/dev/null 2>&1 &
    exec 198<&-
    _mainframe_cli_invoke="$MAINFRAME_ROOT/lib/invoke.sh"
    _mainframe_cli_trust_file_is_safe "$_mainframe_cli_invoke" || exit 126
    unset -f _mainframe_cli_resolve_executable _mainframe_cli_tool_layout_is_known
    unset -f _mainframe_cli_owner_mode _mainframe_cli_path_has_no_write_acl
    unset -f _mainframe_cli_find_trusted_tool _mainframe_cli_trust_file_is_safe
    # shellcheck source=lib/invoke.sh
    source "$_mainframe_cli_invoke"
    _mainframe_invoke_main "$@"
    exit $?
fi

# The project-memory kernel owns the only production entry to project-scoped
# AWM operations. Both hidden spellings are fixed and non-public: the observer
# is metadata-only, while the executor receives identity and liveness
# capabilities on reserved descriptors selected only by the Python supervisor.
if [[ "${1:-}" == "__kernel-project-memory-observer-v1" ||
      "${1:-}" == "__kernel-project-memory-executor-v1" ]]; then
    _mainframe_cli_memory_bridge="$MAINFRAME_ROOT/lib/durable_awm.sh"
    for _mainframe_cli_memory_file in \
        "$_mainframe_cli_memory_bridge" \
        "$MAINFRAME_ROOT/lib/awm.sh" \
        "$MAINFRAME_ROOT/lib/json.sh"; do
        _mainframe_cli_trust_file_is_safe "$_mainframe_cli_memory_file" || exit 126
    done
    # shellcheck source=lib/durable_awm.sh
    source "$_mainframe_cli_memory_bridge"
    if [[ "$1" == "__kernel-project-memory-observer-v1" ]]; then
        (( $# == 5 )) &&
            [[ "$2" == "--format" && "$3" == "project-memory-observation-json-v1" &&
               "$4" == "--caller" && "$5" == "control-plane" ]] || exit 64
        _mainframe_durable_awm_hidden_observer
        exit $?
    fi
    (( $# == 8 )) &&
        [[ "$3" == "--input-json" && "$4" == "-" &&
           "$5" == "--format" && "$6" == "project-memory-executor-json-v1" &&
           "$7" == "--caller" && "$8" == "control-plane" ]] || exit 64
    case "$2" in
        mainframe.project_memory.ensure.v1|\
        mainframe.project_memory.checkpoint.v1|\
        mainframe.project_memory.discovery.v1|\
        mainframe.project_memory.progress.v1|\
        mainframe.project_memory.close.v1|\
        mainframe.project_memory.handoff.v1|\
        mainframe.project_memory.session.v1|\
        mainframe.project_memory.status.v1|\
        mainframe.project_memory.get.v1|\
        mainframe.project_memory.summary.v1|\
        mainframe.project_memory.context.v1|\
        mainframe.project_memory.find.v1) ;;
        *) exit 64 ;;
    esac
    _mainframe_durable_awm_hidden_executor "$2"
    exit $?
fi

# Canonical invocation enters the durable kernel before the fixed hidden broker
# adapter can run. Validate the complete installed Python/Bash bridge here,
# before common.sh can honor profiles, user config, or broad library selection.
if [[ "${1:-}" == "invoke" ]]; then
    _mainframe_cli_durable="$MAINFRAME_ROOT/lib/durable_invoke.sh"
    _mainframe_cli_control_launcher="$MAINFRAME_ROOT/control_plane/mainframe-control-plane"
    if ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_durable" ||
       ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_control_launcher"; then
        echo "MAINFRAME invocation denied: durable control-plane bridge is missing or unsafe" >&2
        exit 126
    fi
    for _mainframe_cli_control_module in \
        __init__.py cli.py coding.py contracts.py durability.py errors.py executor.py \
        kernel.py memory.py memory_executor.py memory_transient.py memory_worker.py \
        transient.py worker.py; do
        _mainframe_cli_trust_file_is_safe \
            "$MAINFRAME_ROOT/control_plane/mainframe_control_plane/$_mainframe_cli_control_module" || {
            echo "MAINFRAME invocation denied: durable control-plane module is missing or unsafe" >&2
            exit 126
        }
    done
    # shellcheck source=lib/durable_invoke.sh
    source "$_mainframe_cli_durable"
    shift
    _mainframe_durable_invoke_main "$@"
    exit $?
fi

# Public coding operations enter the fixed Python control plane before the
# general runtime can load profiles, user configuration, or caller-selected
# libraries. The Bash facade only chooses one reviewed tool ID and constructs
# its closed JSON input on stdin; Python owns identities, policy, execution,
# transient presentation, and Evidence.
if [[ "${1:-}" == "code" ]]; then
    _mainframe_cli_coding_bridge="$MAINFRAME_ROOT/lib/durable_coding.sh"
    _mainframe_cli_control_launcher="$MAINFRAME_ROOT/control_plane/mainframe-control-plane"
    if ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_coding_bridge" ||
       ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_control_launcher"; then
        echo "MAINFRAME code denied: durable control-plane bridge is missing or unsafe" >&2
        exit 126
    fi
    for _mainframe_cli_control_module in \
        __init__.py cli.py coding.py contracts.py durability.py errors.py executor.py \
        kernel.py memory.py memory_executor.py memory_transient.py memory_worker.py \
        transient.py worker.py; do
        _mainframe_cli_trust_file_is_safe \
            "$MAINFRAME_ROOT/control_plane/mainframe_control_plane/$_mainframe_cli_control_module" || {
            echo "MAINFRAME code denied: durable control-plane module is missing or unsafe" >&2
            exit 126
        }
    done
    # shellcheck source=lib/durable_coding.sh
    source "$_mainframe_cli_coding_bridge"
    shift
    _mainframe_durable_coding_main "$@"
    exit $?
fi

# Preflight the complete fixed project-memory closure before common.sh can
# honor profiles or load caller-selected libraries. Generic/session AWM stays
# independent; only the twelve reviewed project operations enter this bridge.
if [[ "${1:-}" == "awm" && "${2:-}" == "project" ]]; then
    case "${3:-}" in
        ensure|checkpoint|discovery|progress|close|handoff|\
        session|status|get|summary|context|find)
            _mainframe_cli_memory_bridge="$MAINFRAME_ROOT/lib/durable_awm.sh"
            _mainframe_cli_control_launcher="$MAINFRAME_ROOT/control_plane/mainframe-control-plane"
            if ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_memory_bridge" ||
               ! _mainframe_cli_trust_file_is_safe "$_mainframe_cli_control_launcher"; then
                echo "Project memory operation denied: durable control-plane bridge is missing or unsafe" >&2
                exit 126
            fi
            for _mainframe_cli_control_module in \
                __init__.py cli.py coding.py contracts.py durability.py errors.py executor.py \
                kernel.py memory.py memory_executor.py memory_transient.py memory_worker.py \
                transient.py worker.py; do
                _mainframe_cli_trust_file_is_safe \
                    "$MAINFRAME_ROOT/control_plane/mainframe_control_plane/$_mainframe_cli_control_module" || {
                    echo "Project memory operation denied: durable control-plane module is missing or unsafe" >&2
                    exit 126
                }
            done
            # shellcheck source=lib/durable_awm.sh
            source "$_mainframe_cli_memory_bridge"
            ;;
    esac
fi

# `work` discovers the same private mapping root as project-memory commands,
# then performs all retrieval through nested public durable reads. Load only
# the fixed discovery bridge here; each nested read independently preflights
# the complete Python/kernel closure before execution.
if [[ "${1:-}" == "work" ]]; then
    _mainframe_cli_memory_bridge="$MAINFRAME_ROOT/lib/durable_awm.sh"
    _mainframe_cli_trust_file_is_safe "$_mainframe_cli_memory_bridge" || {
        echo "MAINFRAME work denied: durable project-memory bridge is missing or unsafe" >&2
        exit 126
    }
    # shellcheck source=lib/durable_awm.sh
    source "$_mainframe_cli_memory_bridge"
fi

# General commands can use the reviewed Git wrapper below. Canonical invoke
# never calls Git, so defer this comparatively expensive discovery until after
# its latency-sensitive fast path.
_MAINFRAME_CLI_GIT="$(_mainframe_cli_find_trusted_tool git 2>/dev/null || true)"
readonly _MAINFRAME_CLI_GIT

unset -f _mainframe_cli_resolve_executable _mainframe_cli_tool_layout_is_known
unset -f _mainframe_cli_owner_mode _mainframe_cli_path_has_no_write_acl
unset -f _mainframe_cli_find_trusted_tool _mainframe_cli_trust_file_is_safe

# AWM is a latency-sensitive command path used repeatedly by coding agents.
# Supply a fallback rather than an override so config-file profiles and library
# selections retain the same precedence as explicit environment settings.
if [[ ( "${1:-}" == "awm" || "${1:-}" == "work" ) &&
      -z "${MAINFRAME_DEFAULT_LIBS+x}" ]]; then
    export MAINFRAME_DEFAULT_LIBS="awm"
fi

# Source common library
source "$MAINFRAME_ROOT/lib/common.sh"

if [[ "$_mainframe_cli_restore_caller_path" == "true" ]]; then
    PATH="$_mainframe_cli_caller_path"
    export PATH
    builtin hash -r
fi
unset _mainframe_cli_restore_caller_path _mainframe_cli_caller_path

# An explicit library selection remains authoritative, but a CLI command must
# still load its own implementation dependency. This adds AWM without changing
# the caller's MAINFRAME_LIBS value or loading unrelated AI libraries.
if [[ ( "${1:-}" == "awm" || "${1:-}" == "work" ) ]] &&
   ! declare -F awm_init >/dev/null 2>&1; then
    source "$MAINFRAME_ROOT/lib/awm.sh"
fi

