_find_operation() {
    local operation="$1"
    local category candidate

    for category in data agent git file api dev; do
        candidate="$MAINFRAME_ROOT/scripts/$category/$operation"
        if [[ -f "$candidate" && -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
        if [[ -f "${candidate}.sh" && -x "${candidate}.sh" ]]; then
            printf '%s\n' "${candidate}.sh"
            return 0
        fi
    done

    return 1
}

cmd_operations() {
    local requested_category="${1:-all}"
    local category script name
    local -a categories=(data agent git file api dev)

    for category in "${categories[@]}"; do
        [[ "$requested_category" == "all" || "$requested_category" == "$category" ]] || continue
        [[ -d "$MAINFRAME_ROOT/scripts/$category" ]] || continue

        printf '%s:\n' "$category"
        for script in "$MAINFRAME_ROOT/scripts/$category"/*; do
            [[ -f "$script" && -x "$script" ]] || continue
            name="$(basename "$script")"
            printf '  %s\n' "${name%.sh}"
        done
    done
}

cmd_operation() {
    local operation="${1:-}"
    local operation_path operation_header=""

    if [[ -z "$operation" ]]; then
        echo "Usage: mainframe run <operation> [args...]" >&2
        return 1
    fi
    shift

    if ! operation_path="$(_find_operation "$operation")"; then
        echo "Operation not found: $operation" >&2
        return 1
    fi

    # Bundled operations may include non-Bash executables. Keep those on their
    # declared interpreter, but never let a Bash operation's env shebang fall
    # back to Apple Bash 3.2 or an unreviewed PATH entry.
    IFS= read -r operation_header < "$operation_path" || true
    case "$operation_header" in
        '#!'*/bash|'#!'*/bash' '*|\
        '#!/usr/bin/env bash'|'#!/usr/bin/env bash '*|\
        '#!/usr/bin/env -S bash'|'#!/usr/bin/env -S bash '*)
            exec "$BASH" --noprofile --norc -p "$operation_path" "$@"
            ;;
    esac

    exec "$operation_path" "$@"
}

# =============================================================================
# PRODUCT-STATE COUNTS (single source of truth: FUNCTIONS.json)
# =============================================================================
# Runtime `declare -F` counts are profile-dependent (lean/lazy loading) and
# must never be reported as the product's function count. All product-state
# surfaces (version, count, doctor) read the canonical registry instead.
#
# Usage: read unique registrations libraries < <(_mainframe_registry_counts)
# Returns 1 when FUNCTIONS.json or jq is unavailable.
_mainframe_registry_counts() {
    local json_file="${MAINFRAME_ROOT}/FUNCTIONS.json"
    [[ -f "$json_file" ]] || return 1
    command -v jq &>/dev/null || return 1
    jq -r '
        .libraries as $libs |
        [
            ([$libs[].functions | keys[]] | unique | length),
            ([$libs[].functions | length] | add),
            ($libs | length)
        ] | @tsv
    ' "$json_file" 2>/dev/null
}

# Runtime diagnostic only: public functions actually loaded in this process.
_mainframe_runtime_loaded_count() {
    declare -F | awk '{print $3}' | grep -vc '^_'
}

cmd_help() {
    local func="${1:-}"
    local json_file="${MAINFRAME_ROOT}/FUNCTIONS.json"
    local operation_path=""

    if [[ -z "$func" ]]; then
        echo "Usage: mainframe help <function_name>"
        echo ""
        echo "Examples:"
        echo "  mainframe help json_object"
        echo "  mainframe help validate_email"
        echo "  mainframe help awm_init"
        echo ""
        echo "Use 'mainframe search <keyword>' to find functions"
        return 0
    fi

    if operation_path="$(_find_operation "$func")"; then
        exec "$operation_path" --help
    fi

    # Check if FUNCTIONS.json exists
    if [[ ! -f "$json_file" ]]; then
        echo "Error: FUNCTIONS.json not found at: $json_file"
        echo "Run 'make docs' to generate function documentation."
        return 1
    fi

    # Search FUNCTIONS.json for the function across all libraries. Keep the
    # matches as an array so duplicate registry owners cannot be concatenated
    # and accidentally formatted as one function record.
    local entries entry match_count lib_name lib_desc
    if ! entries=$(jq -c --arg f "$func" '
        [
            .libraries | to_entries[] |
            select(.value.functions[$f] != null) |
            {
                library: .key,
                library_file: .value.file,
                library_desc: .value.description,
                func: .value.functions[$f]
            }
        ]
    ' "$json_file" 2>/dev/null); then
        echo "Error: unable to read FUNCTIONS.json" >&2
        return 1
    fi

    match_count=$(jq -r 'length' <<< "$entries")
    if [[ "$match_count" -eq 0 ]]; then
        echo "Function '$func' not found in FUNCTIONS.json"
        echo ""
        echo "Use 'mainframe search $func' to search for similar functions."
        return 1
    fi

    if [[ "$match_count" -gt 1 ]]; then
        {
            printf "Error: function '%s' has multiple registry owners:\n" "$func"
            jq -r '.[] | "  - \(.library)"' <<< "$entries"
        } >&2
        return 1
    fi

    entry=$(jq -c '.[0]' <<< "$entries")

    # Extract and display function information
    lib_name=$(echo "$entry" | jq -r '.library')
    lib_desc=$(echo "$entry" | jq -r '.library_desc // "No description"')

    local signature description returns params_json examples_json
    signature=$(echo "$entry" | jq -r '.func.signature // "()"')
    description=$(echo "$entry" | jq -r '.func.description // "No description available"')
    returns=$(echo "$entry" | jq -r '.func.returns // "unspecified"')
    params_json=$(echo "$entry" | jq -r '.func.params // []')
    examples_json=$(echo "$entry" | jq -r '.func.examples // []')

    # Display formatted help
    echo ""
    echo "$func"
    printf '%*s\n' "${#func}" '' | tr ' ' '='
    echo ""
    echo "Library:     $lib_name (lib/${lib_name}.sh)"
    echo "Signature:   $signature"
    echo "Returns:     $returns"
    echo ""
    echo "Description:"
    echo "  $description"

    # Show parameters if present
    local param_count
    param_count=$(echo "$params_json" | jq 'length')
    if [[ "$param_count" -gt 0 ]]; then
        echo ""
        echo "Parameters:"
        echo "$params_json" | jq -r '.[] | "  \(.position). \(.name)\(if .required then " (required)" else " (optional)" end)\(if .default then " [default: \(.default)]" else "" end)"'
    fi

    # Show examples if present
    local example_count
    example_count=$(echo "$examples_json" | jq 'length')
    if [[ "$example_count" -gt 0 ]]; then
        echo ""
        echo "Examples:"
        echo "$examples_json" | jq -r '.[] | "  \(.)"'
    fi

    # Show idempotent/pure flags if available
    local idempotent pure
    idempotent=$(echo "$entry" | jq -r '.func.idempotent // "unknown"')
    pure=$(echo "$entry" | jq -r '.func.pure // "unknown"')
    if [[ "$idempotent" != "unknown" || "$pure" != "unknown" ]]; then
        echo ""
        echo "Properties:"
        [[ "$idempotent" != "unknown" ]] && echo "  Idempotent: $idempotent"
        [[ "$pure" != "unknown" ]] && echo "  Pure:       $pure"
    fi

    echo ""
}

cmd_version() {
    local unique registrations libraries
    echo "MAINFRAME v${MAINFRAME_VERSION:-3.0.0}"
    echo ""
    echo "Environment:"
    echo "  Bash version:    ${BASH_VERSION}"
    echo "  MAINFRAME_ROOT:  ${MAINFRAME_ROOT}"
    if read -r unique registrations libraries < <(_mainframe_registry_counts); then
        echo "  Functions:       ${unique} registry functions (${registrations} registrations across ${libraries} libraries)"
    else
        echo "  Functions:       unavailable (FUNCTIONS.json or jq missing)"
    fi
    echo "  OS:              $(uname -s) $(uname -m)"
}

cmd_functions() {
    # List all functions, excluding internal ones (prefixed with _)
    declare -F | awk '{print $3}' | grep -v '^_' | sort
}

cmd_search() {
    local query="${1:-}"
    local json_file="${MAINFRAME_ROOT}/FUNCTIONS.json"
    local manifest_file="${MAINFRAME_ROOT}/MANIFEST.json"

    if [[ -z "$query" ]]; then
        echo "Usage: mainframe search <pattern>"
        echo 'Example: mainframe search "create json object"'
        return 1
    fi

    if (( ${#query} > 256 )) || [[ "$query" == *$'\n'* || "$query" == *$'\r'* || "$query" == *$'\t'* ]]; then
        echo "Search query must be one printable line of at most 256 characters." >&2
        return 64
    fi
    if [[ ! -f "$json_file" || ! -f "$manifest_file" ]]; then
        echo "Error: canonical discovery metadata is missing under ${MAINFRAME_ROOT}." >&2
        return 1
    fi
    if ! command -v jq &>/dev/null; then
        echo "Error: jq is required for canonical MAINFRAME discovery." >&2
        return 1
    fi

    # Search the generated registry, then retain only the owner selected by
    # MANIFEST.json. Ambiguous registry names stay hidden because `help` also
    # rejects them until their compatibility migration is complete. The query
    # is plain text, never a caller-controlled regular expression.
    local results
    if ! results=$(jq -rn --arg q "$query" \
        --slurpfile registry "$json_file" \
        --slurpfile manifest "$manifest_file" '
        def normalize:
            ascii_downcase
            | gsub("[_./:-]+"; " ")
            | gsub("[[:space:]]+"; " ")
            | ltrimstr(" ") | rtrimstr(" ");
        ($q | normalize) as $query
        | ($query | split(" ") | map(select(length > 0))) as $words
        | ($registry[0].libraries | to_entries) as $libraries
        | (reduce (
              $libraries[] as $library
              | $library.value.functions
              | keys[]
              | {name: ., owner: $library.key}
            ) as $registration
            ({};
              .[$registration.name] =
                ((.[$registration.name] // []) + [$registration.owner])
            )) as $owners_by_name
        | [
            $libraries[] as $library
            | $library.value.functions
            | to_entries[] as $entry
            | select($entry.key | test("^[A-Za-z_][A-Za-z0-9_]*$"))
            | ($owners_by_name[$entry.key] // []) as $owners
            | select($owners | length == 1)
            | ($manifest[0].name_index[$entry.key] // null) as $canonical_id
            | (if $canonical_id then ($manifest[0].exports[$canonical_id] // null) else null end) as $export
            | select($canonical_id != null and $export.name == $entry.key and $export.owner == $library.key)
            | ($entry.key | normalize) as $normalized_name
            | ([
                $entry.key,
                $library.key,
                ($library.value.category // ""),
                ($entry.value.description // ""),
                ($entry.value.signature // ""),
                ($entry.value.returns // ""),
                (($entry.value.examples // []) | join(" "))
              ] | join(" ") | normalize) as $haystack
            | select($words | all(. as $word | $haystack | contains($word)))
            | (($export.profiles // []) | index("stable-core") != null) as $stable_core
            | ($normalized_name | test("(^| )(remove|delete|rm|kill|terminate|destroy|drop|wipe|clean|docker|compose|k8s|kubectl|write|replace|chmod|chown|publish|release|upload|deploy|secret|credential|token|send)( |$)")) as $high_name
            | (if $high_name then "high" elif $stable_core or $entry.value.pure == true then "low" else "medium" end) as $risk
            | (if $normalized_name == $query then 500
               elif $normalized_name | startswith($query) then 400
               elif $normalized_name | contains($query) then 300
               elif (($entry.value.signature // "") | normalize | contains($query)) then 200
               elif (($entry.value.description // "") | normalize | contains($query)) then 150
               else 100 end) as $relevance
            | ((if $stable_core then 40 else 0 end)
               + (if $entry.value.pure == true then 25 else 0 end)
               + (if $entry.value.idempotent == true then 15 else 0 end)
               + (if $risk == "low" then 20 elif $risk == "high" then -40 else 0 end)) as $safety
            | {
                function: $entry.key,
                library: $library.key,
                signature: ($entry.value.signature // ($entry.key + " [args...]")),
                description: ($entry.value.description // ""),
                pure: ($entry.value.pure // false),
                idempotent: ($entry.value.idempotent // false),
                stable_core: $stable_core,
                risk: $risk,
                relevance: $relevance,
                safety: $safety
              }
          ]
        | sort_by([-.relevance, -.safety, .function])
        | .[0:30]
        | .[]
        | "\(.function) - \(.library) [risk=\(.risk)\(if .stable_core then ", stable-core" else "" end)\(if .pure then ", pure" else "" end)\(if .idempotent then ", idempotent" else "" end)]\n  \(.signature)\n  \(.description)"
    ' 2>/dev/null); then
        echo "Error: unable to read canonical discovery metadata." >&2
        return 1
    fi

    if [[ -z "$results" ]]; then
        echo "No canonical functions matching '$query'"
        return 1
    fi

    echo "Canonical functions matching '$query':"
    echo ""
    printf '%s\n' "$results"
    echo ""
    echo "Safety labels are discovery hints, not authorization. Use 'mainframe help <function>' before execution."
}

cmd_count() {
    local unique registrations libraries runtime_loaded

    if ! read -r unique registrations libraries < <(_mainframe_registry_counts); then
        echo "Error: registry counts unavailable (FUNCTIONS.json or jq missing)" >&2
        return 1
    fi

    runtime_loaded=$(_mainframe_runtime_loaded_count)

    echo "Registry functions: ${unique} unique names (${registrations} registrations across ${libraries} libraries)"
    echo "Runtime loaded:     ${runtime_loaded} functions (profile-dependent diagnostic)"
}

cmd_doctor() {
    local errors=0

    echo "MAINFRAME Doctor"
    echo "================"
    echo "Scope: MAINFRAME shell runtime; use 'mainframe pi doctor' for Pi integration."
    echo ""

    # Check MAINFRAME_ROOT
    echo -n "MAINFRAME_ROOT: "
    if [[ -n "${MAINFRAME_ROOT:-}" ]]; then
        echo "$MAINFRAME_ROOT"
    else
        echo "NOT SET (using script directory)"
        errors=$((errors + 1))
    fi

    # Check bash version
    echo -n "Bash version:   "
    if (( BASH_VERSINFO[0] > 4 )) || \
       (( BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4 )); then
        echo "${BASH_VERSION} (OK)"
    else
        echo "${BASH_VERSION} (ERROR: Bash 4.4+ required)"
        errors=$((errors + 1))
    fi

    # Check OS
    echo "OS:             $(uname -s) $(uname -m)"

    # Check libraries loaded
    echo -n "Libraries:      "
    if declare -F json_object &>/dev/null; then
        echo "Loaded (OK)"
    else
        echo "NOT LOADED (ERROR)"
        errors=$((errors + 1))
    fi

    # Count functions (canonical registry count, not profile-dependent runtime)
    local unique registrations libraries runtime_loaded
    if read -r unique registrations libraries < <(_mainframe_registry_counts); then
        echo "Functions:      ${unique} registry functions (${registrations} registrations across ${libraries} libraries)"
    else
        echo "Functions:      REGISTRY UNAVAILABLE (ERROR)"
        errors=$((errors + 1))
    fi
    runtime_loaded=$(_mainframe_runtime_loaded_count)
    echo "Runtime loaded: ${runtime_loaded} functions (profile-dependent diagnostic)"

    # Check common.sh exists
    echo -n "common.sh:      "
    if [[ -f "${MAINFRAME_ROOT}/lib/common.sh" ]]; then
        echo "Found (OK)"
    else
        echo "NOT FOUND (ERROR)"
        errors=$((errors + 1))
    fi

    echo -n "Agent gateway:  "
    if [[ -x "${MAINFRAME_ROOT}/hooks/agent-gateway.sh" ]] && command -v jq &>/dev/null; then
        echo "Ready (OK)"
    else
        echo "NOT READY (requires executable hook and jq)"
        errors=$((errors + 1))
    fi

    if [[ -f "$MAINFRAME_ROOT/lib/shell.sh" && ! -L "$MAINFRAME_ROOT/lib/shell.sh" ]]; then
        # shellcheck source=lib/shell.sh
        source "$MAINFRAME_ROOT/lib/shell.sh"
        if ! _mainframe_shell_doctor_check; then
            errors=$((errors + 1))
        fi
    else
        echo "Shell identity: NOT AVAILABLE (ERROR)"
        errors=$((errors + 1))
    fi

    echo ""

    if ((errors == 0)); then
        echo "Status: All checks passed!"
        return 0
    else
        echo "Status: ${errors} issue(s) found"
        return 1
    fi
}

cmd_benchmark() {
    local benchmark_script="${MAINFRAME_ROOT}/benchmarks/superpower_benchmarks.sh"

    if [[ -f "$benchmark_script" ]]; then
        "$BASH" --noprofile --norc -p "$benchmark_script"
    else
        echo "Benchmark script not found: $benchmark_script"
        return 1
    fi
}

cmd_test() {
    local bats="${MAINFRAME_ROOT}/tests/bats/bin/bats"
    local tests_dir="${MAINFRAME_ROOT}/tests"
    local test_shell="${MAINFRAME_BASH:-$BASH}"

    if [[ ! -x "$bats" ]]; then
        echo "BATS is not installed. Install the integrity-pinned test dependencies:"
        echo ""
        echo "  cd ${MAINFRAME_ROOT}"
        echo "  make test-deps"
        return 1
    fi

    # The CLI bootstrap has already resolved and authenticated this Bash. Keep
    # the defensive check exact so this command cannot silently widen the
    # product's documented >=4.4 runtime contract if called in a new context.
    if ! "$test_shell" --noprofile --norc -p -c '
        (( BASH_VERSINFO[0] > 4 )) ||
        (( BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4 ))
    ' >/dev/null 2>&1; then
        echo "MAINFRAME tests require Bash 4.4+."
        return 1
    fi

    BATS_TEST_SHELL="$test_shell" \
        "$test_shell" --noprofile --norc -p \
        "$bats" "${tests_dir}/unit/" "${tests_dir}/integration/"
}

cmd_update() {
    if [[ $# -ne 0 ]]; then
        echo "Usage: mainframe update" >&2
        return 64
    fi
    if [[ "${MAINFRAME_INSTALL_METHOD:-}" == "homebrew" ]]; then
        echo "MAINFRAME is managed by Homebrew."
        echo ""
        echo "Upgrade with:"
        echo "  brew upgrade gtwatts/mainframe/mainframe"
        return 1
    fi

    if [[ -f "${MAINFRAME_ROOT}/.mainframe-install-receipt.json" ]]; then
        echo "This is a receipt-backed release installation."
        echo "Use an explicit version, for example:"
        echo "  mainframe upgrade --version 10.2.1 --confirm-agents-stopped"
        return 1
    fi

    if ! _mainframe_git -C "$MAINFRAME_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Update only works for git-based installations."
        echo ""
        echo "If installed via basher, run:"
        echo "  basher upgrade gtwatts/mainframe"
        return 1
    fi

    local branch
    branch="$(_mainframe_git -C "$MAINFRAME_ROOT" branch --show-current 2>/dev/null || true)"
    if [[ "$branch" != "main" ]]; then
        echo "Refusing to update a non-main or detached checkout (${branch:-detached HEAD})." >&2
        return 1
    fi
    if [[ -n "$(_mainframe_git -C "$MAINFRAME_ROOT" status --porcelain 2>/dev/null)" ]]; then
        echo "Refusing to update a checkout with local changes." >&2
        return 1
    fi

    echo "Updating MAINFRAME..."
    _mainframe_git -C "$MAINFRAME_ROOT" fetch --prune origin main
    _mainframe_git -C "$MAINFRAME_ROOT" merge --ff-only FETCH_HEAD
    echo ""
    echo "Updated! Run 'mainframe doctor' to verify."
}

_mainframe_git() (
    local config_variable
    [[ -n "$_MAINFRAME_CLI_GIT" ]] || return 127
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
    unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    unset GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM
    unset GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
    unset GIT_EXEC_PATH GIT_PROXY_COMMAND GIT_SSH GIT_SSH_COMMAND GIT_ASKPASS
    unset SSH_ASKPASS GIT_TEMPLATE_DIR
    while IFS= read -r config_variable; do
        unset "$config_variable"
    done < <(compgen -A variable GIT_CONFIG_KEY_ || true)
    while IFS= read -r config_variable; do
        unset "$config_variable"
    done < <(compgen -A variable GIT_CONFIG_VALUE_ || true)
    export GIT_CONFIG_COUNT=0
    "$_MAINFRAME_CLI_GIT" "$@"
)

_mainframe_sha256_file() {
    local file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        command sha256sum "$file" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        command shasum -a 256 "$file" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        command openssl dgst -sha256 "$file" | awk '{print $NF}'
    else
        return 127
    fi
}

_mainframe_path_mode() {
    local path="$1" value=""
    value="$(stat -c '%a' "$path" 2>/dev/null || true)"
    if [[ "$value" =~ ^[0-7]{3,4}$ ]]; then
        printf '%s\n' "$value"
        return 0
    fi
    value="$(stat -f '%Lp' "$path" 2>/dev/null || true)"
    [[ "$value" =~ ^[0-7]{3,4}$ ]] && printf '%s\n' "$value"
}

_mainframe_release_owns_uninstaller() {
    local uninstaller="$1"
    local receipt="$MAINFRAME_ROOT/.mainframe-install-receipt.json"
    local manifest="$MAINFRAME_ROOT/SHA256SUMS"
    local receipt_manifest_sha manifest_sha expected_sha="" actual_sha
    local line mode match_count=0

    [[ -f "$receipt" && ! -L "$receipt" ]] || return 1
    mode="$(_mainframe_path_mode "$receipt")"
    [[ "$mode" == "600" ]] || return 1
    [[ -f "$manifest" && ! -L "$manifest" ]] || return 1
    command -v jq >/dev/null 2>&1 || return 1

    receipt_manifest_sha="$(jq -er --arg root "$MAINFRAME_ROOT" '
      select(
        type == "object" and
        (keys | sort) == ["archive_sha256", "bin_dir", "cli_link", "install_dir", "install_method", "installed_at", "manifest_sha256", "schema_version", "version"] and
        .schema_version == 1 and .install_method == "release-archive" and
        (.version | type == "string" and test("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")) and
        (.archive_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
        (.manifest_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
        .install_dir == $root and
        (.bin_dir | type == "string" and startswith("/") and (test("[[:cntrl:]]") | not)) and
        (.cli_link | type == "string" and startswith("/") and (test("[[:cntrl:]]") | not)) and
        (.installed_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
      ) | .manifest_sha256
    ' "$receipt" 2>/dev/null)" || return 1

    manifest_sha="$(_mainframe_sha256_file "$manifest")" || return 1
    [[ "$manifest_sha" == "$receipt_manifest_sha" ]] || return 1

    while IFS= read -r line || [[ -n "$line" ]]; do
        if (( ${#line} == 78 )) &&
           [[ "${line:64:2}" == "  " && "${line:66}" == "uninstall.sh" &&
              "${line:0:64}" =~ ^[0-9a-f]{64}$ ]]; then
            expected_sha="${line:0:64}"
            match_count=$((match_count + 1))
        fi
    done < "$manifest"
    (( match_count == 1 )) || return 1

    actual_sha="$(_mainframe_sha256_file "$uninstaller")" || return 1
    [[ "$actual_sha" == "$expected_sha" ]]
}

_mainframe_source_owns_uninstaller() {
    local uninstaller="$1"
    local top expected_object actual_object

    top="$(_mainframe_git -C "$MAINFRAME_ROOT" rev-parse --show-toplevel 2>/dev/null)" || return 1
    [[ -d "$top" ]] || return 1
    top="$(cd "$top" && pwd -P)"
    [[ "$top" == "$MAINFRAME_ROOT" ]] || return 1

    expected_object="$(_mainframe_git -C "$MAINFRAME_ROOT" rev-parse 'HEAD:uninstall.sh' 2>/dev/null)" || return 1
    actual_object="$(_mainframe_git -C "$MAINFRAME_ROOT" hash-object --no-filters -- "$uninstaller" 2>/dev/null)" || return 1
    [[ "$expected_object" =~ ^[0-9a-f]{40,64}$ && "$actual_object" == "$expected_object" ]]
}

# A deliberately tiny ownership fixture or a legacy install may contain none
# of the Pi lifecycle payload.  Once any trusted install signal advertises the
# payload, however, every required file must remain available so uninstall can
# prove that Pi will not retain a dangling package entry.
_mainframe_pi_uninstall_payload_expected() {
    local manifest="$MAINFRAME_ROOT/SHA256SUMS"
    local relative required line source_top=''

    [[ "${MAINFRAME_PI_LIFECYCLE_REQUIRED:-}" == 1 ]] && return 0

    for relative in \
        package.json \
        lib/pi.sh \
        skills/pi/SKILL.md \
        skills/pi/extensions/mainframe.ts; do
        required="$MAINFRAME_ROOT/$relative"
        [[ -e "$required" || -L "$required" ]] && return 0
    done

    # A committed source checkout remains Pi-capable even if every working-tree
    # copy was removed.  Minimal test/legacy repositories do not advertise any
    # of these paths in HEAD and therefore retain their historical behavior.
    source_top="$(_mainframe_git -C "$MAINFRAME_ROOT" rev-parse --show-toplevel \
        2>/dev/null || true)"
    if [[ -n "$source_top" && -d "$source_top" ]]; then
        if ! source_top="$(cd -- "$source_top" 2>/dev/null && pwd -P)"; then
            source_top=""
        fi
        if [[ "$source_top" == "$MAINFRAME_ROOT" ]]; then
            for relative in \
                package.json \
                lib/pi.sh \
                skills/pi/SKILL.md \
                skills/pi/extensions/mainframe.ts; do
                if _mainframe_git -C "$MAINFRAME_ROOT" cat-file -e \
                    "HEAD:$relative" 2>/dev/null; then
                    return 0
                fi
            done
        fi
    fi

    # Receipt-backed releases advertise payload ownership in their embedded
    # manifest.  Reading exact record names here is intentionally fail-closed;
    # receipt authenticity is still verified before the uninstaller executes.
    if [[ -f "$MAINFRAME_ROOT/.mainframe-install-receipt.json" &&
          ! -L "$MAINFRAME_ROOT/.mainframe-install-receipt.json" &&
          -f "$manifest" && ! -L "$manifest" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            (( ${#line} >= 67 )) || continue
            [[ "${line:0:64}" =~ ^[0-9a-f]{64}$ &&
               "${line:64:2}" == "  " ]] || continue
            case "${line:66}" in
                package.json|lib/pi.sh|skills/pi/SKILL.md|skills/pi/extensions/mainframe.ts)
                    return 0
                    ;;
            esac
        done < "$manifest"
    fi
    return 1
}

_mainframe_pi_uninstall_interlock() {
    local relative required
    local incomplete=false
    local pi_library="$MAINFRAME_ROOT/lib/pi.sh"

    _mainframe_pi_uninstall_payload_expected || return 0

    for relative in \
        package.json \
        lib/pi.sh \
        skills/pi/SKILL.md \
        skills/pi/extensions/mainframe.ts; do
        required="$MAINFRAME_ROOT/$relative"
        if [[ ! -f "$required" || -L "$required" ]]; then
            if [[ "$incomplete" == false ]]; then
                echo "MAINFRAME Pi lifecycle payload is incomplete or unsafe; refusing uninstall." >&2
                incomplete=true
            fi
            echo "Missing or unsafe required file: $required" >&2
        fi
    done
    if [[ "$incomplete" == true ]]; then
        echo "Restore or reinstall this Mainframe version, then detach Pi before uninstalling." >&2
        return 77
    fi

    # shellcheck source=lib/pi.sh
    if ! source "$pi_library"; then
        echo "MAINFRAME could not load its Pi uninstall interlock; refusing uninstall." >&2
        return 77
    fi
    if ! declare -F _mainframe_pi_uninstall_guard >/dev/null; then
        echo "MAINFRAME Pi uninstall interlock is unavailable; refusing uninstall." >&2
        return 77
    fi
    _mainframe_pi_uninstall_guard
}

cmd_uninstall() {
    local uninstaller="$MAINFRAME_ROOT/uninstall.sh"
    local receipt="$MAINFRAME_ROOT/.mainframe-install-receipt.json"

    _mainframe_pi_uninstall_interlock || return $?

    if [[ "${MAINFRAME_INSTALL_METHOD:-}" == "homebrew" ]]; then
        echo "MAINFRAME is managed by Homebrew."
        echo "Before uninstalling, deactivate MAINFRAME in every onboarded project:"
        echo "  cd /path/to/project"
        echo "  mainframe deactivate HOST --project . --enforce"
        echo "If Pi is attached, preview and detach it too:"
        echo "  mainframe pi remove --dry-run"
        echo "  mainframe pi remove --yes"
        echo ""
        echo "Uninstall with:"
        echo "  brew uninstall gtwatts/mainframe/mainframe"
        echo "Homebrew cannot run this preflight automatically; direct uninstall can strand project hooks or a Pi package path."
        return 1
    fi
    if [[ -L "$uninstaller" ]]; then
        echo "The trusted MAINFRAME uninstaller must not be a symbolic link: $uninstaller" >&2
        return 1
    fi
    if [[ ! -e "$uninstaller" ]]; then
        echo "The trusted MAINFRAME uninstaller is missing: $uninstaller" >&2
        return 1
    fi
    if [[ ! -f "$uninstaller" ]]; then
        echo "The trusted MAINFRAME uninstaller must be a regular file: $uninstaller" >&2
        return 1
    fi
    if [[ ! -O "$uninstaller" ]]; then
        echo "The trusted MAINFRAME uninstaller is not owned by the current user: $uninstaller" >&2
        return 1
    fi

    if [[ -e "$receipt" || -L "$receipt" ]]; then
        if ! _mainframe_release_owns_uninstaller "$uninstaller"; then
            echo "The MAINFRAME uninstaller is not owned by this verified release: $uninstaller" >&2
            return 1
        fi
    elif ! _mainframe_source_owns_uninstaller "$uninstaller"; then
        echo "The MAINFRAME uninstaller is not owned by this source checkout: $uninstaller" >&2
        return 1
    fi

    exec env MAINFRAME_VERSION= MAINFRAME_ROOT="$MAINFRAME_ROOT" \
        MAINFRAME_INSTALL_DIR="$MAINFRAME_ROOT" MAINFRAME_BASH="$BASH" \
        "$BASH" --noprofile --norc -p "$uninstaller" "$@"
}

cmd_upgrade() {
    local updater="$MAINFRAME_ROOT/scripts/upgrade-release.sh"

    if [[ "${MAINFRAME_INSTALL_METHOD:-}" == "homebrew" ]]; then
        echo "MAINFRAME is managed by Homebrew."
        echo "Upgrade with:"
        echo "  brew upgrade gtwatts/mainframe/mainframe"
        return 1
    fi
    if _mainframe_git -C "$MAINFRAME_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "This is a source checkout; use 'mainframe update' for a fast-forward-only update." >&2
        return 1
    fi
    if [[ ! -f "$MAINFRAME_ROOT/.mainframe-install-receipt.json" ]]; then
        echo "Transactional upgrade requires a verified release receipt." >&2
        echo "Install one explicit release with get-mainframe.sh before using this command." >&2
        return 1
    fi
    if [[ ! -f "$updater" || -L "$updater" ]]; then
        echo "The trusted release upgrader is missing or symbolic-linked: $updater" >&2
        return 1
    fi

    env MAINFRAME_VERSION= MAINFRAME_ROOT="$MAINFRAME_ROOT" MAINFRAME_BASH="$BASH" \
        "$BASH" --noprofile --norc -p "$updater" "$@"
}

declare -a CMD_AWM_ARGS=()

_cmd_awm_extract_session() {
    local __target="$1"
    shift
    local session="${MAINFRAME_AWM_SESSION:-${AWM_SESSION_ID:-}}"
    local -a remainder=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session)
                session="${2:-$session}"
                shift 2
                ;;
            *)
                remainder+=("$1")
                shift
                ;;
        esac
    done

    printf -v "$__target" '%s' "$session"
    CMD_AWM_ARGS=("${remainder[@]}")
}

_cmd_awm_require_session() {
    local session="$1"
    if [[ -z "$session" ]]; then
        echo "Session required. Pass --session <sid> or set MAINFRAME_AWM_SESSION."
        return 1
    fi
    _cmd_awm_reject_project_session "$session" || return 1
    awm_resume "$session" >/dev/null
}

# Project-backed AWM sessions have a separate consent and lifecycle contract.
# Keep their opaque SIDs out of the generic session CLI so a caller cannot use
# resume/checkpoint/export/etc. to bypass `awm project ensure` and its active
# mapping checks. This is a CLI boundary; direct same-user filesystem access is
# outside MAINFRAME's shell-policy threat model.
_cmd_awm_reject_project_session() {
    local session="${1:-}"

    [[ -n "$session" ]] || return 0
    _awm_validate_session_id "$session" 1 || return 0
    if _awm_session_is_project_reserved "$session"; then
        echo "Project memory is available only through 'mainframe awm project ...'" >&2
        return 1
    fi
    return 0
}

_cmd_awm_reject_project_init_args() {
    local positional=0
    local value=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --namespace)
                value="${2:-}"
                if [[ "$value" == "projects" ]]; then
                    echo "The projects namespace is reserved for explicit 'mainframe awm project ensure'" >&2
                    return 1
                fi
                shift 2
                ;;
            --namespace=projects)
                echo "The projects namespace is reserved for explicit 'mainframe awm project ensure'" >&2
                return 1
                ;;
            --parent)
                value="${2:-}"
                _cmd_awm_reject_project_session "$value" || return 1
                shift 2
                ;;
            --model|--backend)
                shift 2
                ;;
            --*)
                shift
                ;;
            *)
                positional=$((positional + 1))
                if [[ "$positional" -eq 2 ]]; then
                    _cmd_awm_reject_project_session "$1" || return 1
                fi
                shift
                ;;
        esac
    done
}

_cmd_awm_migrate_non_project_all() {
    local sid="" _name="" _status="" _created_at=""
    local count=0

    while IFS=$'\t' read -r sid _name _status _created_at; do
        [[ -n "$sid" ]] || continue
        awm_migrate "$sid" >/dev/null || return 1
        count=$((count + 1))
    done < <(awm_list --exclude-namespace projects)
    printf '%s' "$count"
}

declare -a CMD_AWM_PROJECT_ARGS=()
CMD_AWM_PROJECT_END_OF_OPTIONS=false

_cmd_awm_extract_project() {
    local __target="$1"
    local action="$2"
    shift 2
    local resolved_project="."
    local seen=false
    local discover_root=false
    local seen_discover_root=false
    local -a remainder=()

    CMD_AWM_PROJECT_END_OF_OPTIONS=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)
                if [[ "$seen" == "true" || $# -lt 2 || -z "${2:-}" || "$2" == -* ]]; then
                    echo "--project requires exactly one directory" >&2
                    return 2
                fi
                resolved_project="$2"
                seen=true
                shift 2
                ;;
            --discover-root)
                if [[ "$seen_discover_root" == "true" ]]; then
                    echo "--discover-root may be passed only once" >&2
                    return 2
                fi
                discover_root=true
                seen_discover_root=true
                shift
                ;;
            --project=*)
                echo "--project must be passed as --project <directory>" >&2
                return 2
                ;;
            --discover-root=*)
                echo "--discover-root does not take a value" >&2
                return 2
                ;;
            --)
                if (( ${#remainder[@]} > 0 )) && \
                   [[ ! ( "$action" == "handoff" && ${#remainder[@]} -eq 1 && \
                           "${remainder[0]}" == "prepare" ) ]]; then
                    echo "-- must appear before action data" >&2
                    return 2
                fi
                CMD_AWM_PROJECT_END_OF_OPTIONS=true
                shift
                while [[ $# -gt 0 ]]; do
                    remainder+=("$1")
                    shift
                done
                break
                ;;
            *)
                remainder+=("$1")
                shift
                ;;
        esac
    done

    if [[ "$discover_root" == "true" ]]; then
        if declare -F _mainframe_durable_awm_discover_root >/dev/null 2>&1; then
            resolved_project=$(
                _mainframe_durable_awm_discover_root "$resolved_project"
            ) || return 1
        else
            resolved_project=$(_awm_project_discover_root "$resolved_project") || return 1
        fi
    fi
    printf -v "$__target" '%s' "$resolved_project"
    CMD_AWM_PROJECT_ARGS=("${remainder[@]}")
}

_cmd_awm_project_reject_flag_value() {
    local action="$1" value="${2:-}"

    if [[ "$CMD_AWM_PROJECT_END_OF_OPTIONS" != "true" && "$value" == -* ]]; then
        echo "Unknown project ${action} option: $value (use -- before flag-looking data)" >&2
        return 2
    fi
}

_cmd_awm_project_validate_uint() {
    local value="$1" label="$2" maximum="$3" allow_zero="$4"
    local normalized

    if [[ ! "$value" =~ ^[0-9]+$ || ${#value} -gt 10 ]]; then
        echo "$label must be a non-negative integer" >&2
        return 2
    fi
    normalized=$((10#$value))
    if (( normalized > maximum )); then
        echo "$label exceeds maximum $maximum" >&2
        return 2
    fi
    if [[ "$allow_zero" != "true" && "$normalized" -eq 0 ]]; then
        echo "$label must be greater than zero" >&2
        return 2
    fi
}

_cmd_awm_project_validate_option_value() {
    local action="$1" option="$2" value="${3:-}"

    if [[ -z "$value" || "$value" == -* ]]; then
        echo "$option requires a value" >&2
        return 2
    fi
    case "$option" in
        --importance)
            case "$value" in
                critical|high|normal|low) ;;
                *)
                    echo "$option must be critical, high, normal, or low" >&2
                    return 2
                    ;;
            esac
            ;;
        --ttl)
            _cmd_awm_project_validate_uint "$value" "checkpoint TTL" 315360000 true || return 2
            ;;
        --tokens)
            if [[ "$action" == "handoff" ]]; then
                _cmd_awm_project_validate_uint "$value" "handoff token budget" 1000000 false || return 2
            else
                _cmd_awm_project_validate_uint "$value" "${action} token budget" 1000000 true || return 2
            fi
            ;;
        --format)
            case "$value" in
                json|prompt) ;;
                *)
                    echo "$option must be json or prompt" >&2
                    return 2
                    ;;
            esac
            ;;
        --kind)
            case "$value" in
                discovery|checkpoint|log|mixed) ;;
                *)
                    echo "$option must be discovery, checkpoint, log, or mixed" >&2
                    return 2
                    ;;
            esac
            ;;
        --limit)
            _cmd_awm_project_validate_uint "$value" "find result limit" 100000 false || return 2
            ;;
        --tags|--include)
            ;;
        *)
            echo "Unknown project $action option: $option" >&2
            return 2
            ;;
    esac
}

# Validate the complete public action grammar before awm_project_ensure can
# create a mapping. Core AWM functions retain their direct-call compatibility,
# but the project-scoped CLI must never turn a typo into a write for cwd.
_cmd_awm_validate_project_action_args() {
    local action="$1"
    shift

    case "$action" in
        checkpoint)
            [[ $# -ge 2 ]] || {
                echo "Usage: mainframe awm project checkpoint --project <dir> [--discover-root] <key> <value> [--importance LEVEL] [--tags CSV] [--ttl SEC]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            _cmd_awm_project_reject_flag_value "$action" "$2" || return 2
            [[ -n "$1" ]] || {
                echo "Project checkpoint key must not be empty" >&2
                return 2
            }
            shift 2
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --importance|--tags|--ttl)
                        [[ $# -ge 2 ]] || {
                            echo "$1 requires a value" >&2
                            return 2
                        }
                        _cmd_awm_project_validate_option_value "$action" "$1" "$2" || return 2
                        shift 2
                        ;;
                    *)
                        echo "Unknown project checkpoint option: $1" >&2
                        return 2
                        ;;
                esac
            done
            ;;
        discovery)
            [[ $# -ge 1 ]] || {
                echo "Usage: mainframe awm project discovery --project <dir> [--discover-root] <text> [--importance LEVEL] [--tags CSV]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            [[ -n "$1" ]] || {
                echo "Project discovery text must not be empty" >&2
                return 2
            }
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --importance|--tags)
                        [[ $# -ge 2 ]] || {
                            echo "$1 requires a value" >&2
                            return 2
                        }
                        _cmd_awm_project_validate_option_value "$action" "$1" "$2" || return 2
                        shift 2
                        ;;
                    *)
                        echo "Unknown project discovery option: $1" >&2
                        return 2
                        ;;
                esac
            done
            ;;
        progress)
            [[ $# -ge 2 && $# -le 3 ]] || {
                echo "Usage: mainframe awm project progress --project <dir> [--discover-root] <task> <current/total> [status]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            _cmd_awm_project_reject_flag_value "$action" "$2" || return 2
            [[ -n "$1" && "$2" =~ ^[0-9]+/[0-9]+$ ]] || {
                echo "Project progress requires a non-empty task and numeric current/total" >&2
                return 2
            }
            local progress_current="${2%/*}" progress_total="${2#*/}"
            _cmd_awm_project_validate_uint "$progress_current" "progress current" 1000000000 true || return 2
            _cmd_awm_project_validate_uint "$progress_total" "progress total" 1000000000 true || return 2
            [[ $# -lt 3 ]] || _cmd_awm_project_reject_flag_value "$action" "$3" || return 2
            ;;
        get)
            [[ $# -ge 1 && $# -le 2 ]] || {
                echo "Usage: mainframe awm project get --project <dir> [--discover-root] <key> [default]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            [[ -n "$1" ]] || {
                echo "Project get key must not be empty" >&2
                return 2
            }
            [[ $# -lt 2 ]] || _cmd_awm_project_reject_flag_value "$action" "$2" || return 2
            ;;
        summary)
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tokens)
                        [[ $# -ge 2 ]] || {
                            echo "--tokens requires a value" >&2
                            return 2
                        }
                        _cmd_awm_project_validate_option_value "$action" "$1" "$2" || return 2
                        shift 2
                        ;;
                    *)
                        echo "Unknown project summary option: $1" >&2
                        return 2
                        ;;
                esac
            done
            ;;
        context)
            [[ $# -ge 1 ]] || {
                echo "Usage: mainframe awm project context --project <dir> [--discover-root] <task> [--tokens N] [--format json|prompt]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            [[ -n "$1" ]] || {
                echo "Project context task must not be empty" >&2
                return 2
            }
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tokens|--format|--include)
                        [[ $# -ge 2 ]] || {
                            echo "$1 requires a value" >&2
                            return 2
                        }
                        _cmd_awm_project_validate_option_value "$action" "$1" "$2" || return 2
                        shift 2
                        ;;
                    *)
                        echo "Unknown project context option: $1" >&2
                        return 2
                        ;;
                esac
            done
            ;;
        find)
            [[ $# -ge 1 ]] || {
                echo "Usage: mainframe awm project find --project <dir> [--discover-root] <query> [--kind KIND] [--limit N]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            [[ -n "$1" ]] || {
                echo "Project find query must not be empty" >&2
                return 2
            }
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --kind|--limit)
                        [[ $# -ge 2 ]] || {
                            echo "$1 requires a value" >&2
                            return 2
                        }
                        _cmd_awm_project_validate_option_value "$action" "$1" "$2" || return 2
                        shift 2
                        ;;
                    *)
                        echo "Unknown project find option: $1" >&2
                        return 2
                        ;;
                esac
            done
            ;;
        handoff)
            [[ $# -ge 1 ]] || {
                echo "Usage: mainframe awm project handoff prepare --project <dir> [--discover-root] <target> [--tokens N] [--format json|prompt]" >&2
                return 2
            }
            _cmd_awm_project_reject_flag_value "$action" "$1" || return 2
            [[ -n "$1" ]] || {
                echo "Project handoff target must not be empty" >&2
                return 2
            }
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tokens|--format)
                        [[ $# -ge 2 ]] || {
                            echo "$1 requires a value" >&2
                            return 2
                        }
                        _cmd_awm_project_validate_option_value "$action" "$1" "$2" || return 2
                        shift 2
                        ;;
                    *)
                        echo "Unknown project handoff option: $1" >&2
                        return 2
                        ;;
                esac
            done
            ;;
        *)
            echo "Unknown project action validator: $action" >&2
            return 2
            ;;
    esac
}

_cmd_awm_project_help() {
    cat <<'EOF'
MAINFRAME project-scoped AWM

Each command resolves the canonical physical project to one private AWM
session, so separate coding-agent shell processes do not need to retain a SID.

Usage:
  mainframe awm project ensure --project <dir> [--discover-root] [--name NAME]
  mainframe awm project session --project <dir> [--discover-root]
  mainframe awm project status --project <dir> [--discover-root]
  mainframe awm project checkpoint --project <dir> [--discover-root] <key> <value> [options]
  mainframe awm project get --project <dir> [--discover-root] <key> [default]
  mainframe awm project discovery --project <dir> [--discover-root] <text> [options]
  mainframe awm project progress --project <dir> [--discover-root] <task> <current/total> [status]
  mainframe awm project close --project <dir> [--discover-root]
  mainframe awm project summary --project <dir> [--discover-root] [--tokens N]
  mainframe awm project context --project <dir> [--discover-root] <task> [--tokens N] [--format json|prompt]
  mainframe awm project find --project <dir> [--discover-root] <query> [--kind KIND] [--limit N]
  mainframe awm project handoff prepare --project <dir> [--discover-root] <target> [--tokens N] [--format json|prompt]

All six project mutations and all six project reads use the reviewed durable
control-plane route. Mutations produce kernel-bound, non-authoritative
MemoryRecord provenance. Reads return one-consumer untrusted output while
durable Evidence retains metadata only. There is no legacy fallback.

`--discover-root` selects the nearest MAINFRAME-managed project root without
crossing the current Git worktree boundary. A valid private mapping preserves
that root after marker removal; otherwise discovery uses the worktree root, or
the exact directory outside Git. Omit it when --project must identify the exact
physical directory. Use `--` before an action key, value, task, or query that
begins with a dash.
EOF
}

cmd_awm_project() {
    local action="${1:-help}"
    shift || true
    local project="."

    case "$action" in
        help|-h|--help)
            _cmd_awm_project_help
            ;;
        ensure)
            _cmd_awm_extract_project project "$action" "$@" || return $?
            set -- "${CMD_AWM_PROJECT_ARGS[@]}"
            local name=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --name)
                        [[ $# -ge 2 && -n "${2:-}" && "$2" != -* ]] || {
                            echo "--name requires a value" >&2
                            return 2
                        }
                        name="$2"
                        shift 2
                        ;;
                    *)
                        echo "Unknown project ensure option: $1" >&2
                        return 2
                        ;;
                esac
            done
            _mainframe_durable_awm_public_mutation ensure "$project" "$name"
            ;;
        session|status)
            _cmd_awm_extract_project project "$action" "$@" || return $?
            set -- "${CMD_AWM_PROJECT_ARGS[@]}"
            [[ $# -eq 0 ]] || {
                echo "Usage: mainframe awm project $action --project <dir> [--discover-root]" >&2
                return 2
            }
            _mainframe_durable_awm_public_read "$action" "$project"
            ;;
        checkpoint|discovery|progress|get|summary|context|find)
            _cmd_awm_extract_project project "$action" "$@" || return $?
            set -- "${CMD_AWM_PROJECT_ARGS[@]}"
            _cmd_awm_validate_project_action_args "$action" "$@" || return $?
            case "$action" in
                checkpoint|discovery|progress)
                    _mainframe_durable_awm_public_mutation "$action" "$project" "$@"
                    return $?
                    ;;
            esac
            _mainframe_durable_awm_public_read "$action" "$project" "$@"
            ;;
        close)
            _cmd_awm_extract_project project "$action" "$@" || return $?
            set -- "${CMD_AWM_PROJECT_ARGS[@]}"
            [[ $# -eq 0 ]] || {
                echo "Usage: mainframe awm project close --project <dir> [--discover-root]" >&2
                return 2
            }
            _mainframe_durable_awm_public_mutation close "$project"
            ;;
        handoff)
            _cmd_awm_extract_project project "$action" "$@" || return $?
            set -- "${CMD_AWM_PROJECT_ARGS[@]}"
            local handoff_action="${1:-prepare}"
            if [[ "$handoff_action" == "prepare" ]]; then
                shift || true
            elif [[ "$handoff_action" == "accept" ]]; then
                echo "Project-scoped handoff currently supports prepare only" >&2
                return 2
            fi
            _cmd_awm_validate_project_action_args handoff "$@" || return $?
            _mainframe_durable_awm_public_mutation handoff "$project" "$@"
            ;;
        *)
            _cmd_awm_project_help >&2
            return 2
            ;;
    esac
}

_cmd_awm_help() {
    cat << 'EOF'
MAINFRAME AWM

Usage:
  mainframe awm init [name] [--parent ID] [--namespace NS] [--model MODEL] [--backend file|redis|chromadb|auto]
  mainframe awm project <ensure|session|status|checkpoint|get|discovery|progress|close|summary|context|find|handoff> --project <dir> [--discover-root] ...
  mainframe awm resume <session_id>
  mainframe awm checkpoint --session <sid> <key> <value> [--importance LEVEL] [--tags CSV] [--ttl SEC]
  mainframe awm discovery --session <sid> <text> [--importance LEVEL] [--tags CSV]
  mainframe awm progress --session <sid> <task> <current/total> [status]
  mainframe awm get --session <sid> <key> [default]
  mainframe awm summary --session <sid> [--tokens N]
  mainframe awm context --session <sid> <task> [--tokens N] [--format json|prompt] [--include LIST]
  mainframe awm find --session <sid> <query> [--kind discovery|checkpoint|log|mixed] [--limit N]
  mainframe awm handoff prepare --session <sid> <target> [--tokens N] [--format json|prompt]
  mainframe awm handoff accept [--session <sid>] <handoff_json>
  mainframe awm list [--json|--active|--completed]
  mainframe awm status [--session <sid>|<sid>]
  mainframe awm doctor [--session <sid>|<sid>]
  mainframe awm export --session <sid> [path]
  mainframe awm inspect <sid>
  mainframe awm migrate <sid|--all>

Examples:
  mainframe awm project ensure --project . --discover-root
  mainframe awm project context --project . --discover-root "current task" --tokens 1200 --format prompt
  mainframe awm project checkpoint --project . --discover-root current_phase implementation --importance high
  mainframe awm init security-audit --namespace team-red
  mainframe awm checkpoint --session abc123def456 current_step 3 --importance high
  mainframe awm discovery --session abc123def456 "Auth uses JWT refresh tokens"
  mainframe awm find --session abc123def456 jwt --kind mixed --limit 5
  mainframe awm handoff prepare --session abc123def456 review-agent --tokens 2000
EOF
}

cmd_awm() {
    local subcommand="${1:-help}"
    shift || true

    case "$subcommand" in
        help|-h|--help)
            _cmd_awm_help
            ;;
        project)
            cmd_awm_project "$@"
            ;;
        init)
            _cmd_awm_reject_project_init_args "$@" || return 1
            awm_init "$@"
            ;;
        resume)
            if [[ -z "${1:-}" ]]; then
                echo "Usage: mainframe awm resume <session_id>"
                return 1
            fi
            _cmd_awm_reject_project_session "$1" || return 1
            awm_resume "$1" >/dev/null && printf '%s\n' "$_AWM_SESSION_ID"
            ;;
        checkpoint)
            local checkpoint_session=""
            _cmd_awm_extract_session checkpoint_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$checkpoint_session" || return 1
            awm_checkpoint "$@"
            ;;
        discovery)
            local discovery_session=""
            _cmd_awm_extract_session discovery_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$discovery_session" || return 1
            awm_discovery "$@"
            ;;
        progress)
            local progress_session=""
            _cmd_awm_extract_session progress_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$progress_session" || return 1
            awm_progress "$@"
            ;;
        get)
            local get_session=""
            _cmd_awm_extract_session get_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$get_session" || return 1
            awm_get "$@"
            ;;
        summary)
            local summary_session=""
            _cmd_awm_extract_session summary_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$summary_session" || return 1
            awm_summary "$@"
            ;;
        context)
            local context_session=""
            _cmd_awm_extract_session context_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$context_session" || return 1
            awm_context_for "$@"
            ;;
        find)
            local find_session=""
            _cmd_awm_extract_session find_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$find_session" || return 1
            awm_find "$@"
            ;;
        handoff)
            local action="${1:-prepare}"
            shift || true
            case "$action" in
                prepare)
                    local handoff_session=""
                    _cmd_awm_extract_session handoff_session "$@"
                    set -- "${CMD_AWM_ARGS[@]}"
                    _cmd_awm_require_session "$handoff_session" || return 1
                    awm_handoff_prepare "$@"
                    ;;
                accept)
                    local accept_session=""
                    _cmd_awm_extract_session accept_session "$@"
                    set -- "${CMD_AWM_ARGS[@]}"
                    if [[ -n "$accept_session" ]]; then
                        _cmd_awm_reject_project_session "$accept_session" || return 1
                        awm_resume "$accept_session" >/dev/null || return 1
                    fi
                    awm_handoff_accept "$@"
                    ;;
                *)
                    local handoff_session=""
                    _cmd_awm_extract_session handoff_session "$action" "$@"
                    set -- "${CMD_AWM_ARGS[@]}"
                    _cmd_awm_require_session "$handoff_session" || return 1
                    awm_handoff_prepare "$@"
                    ;;
            esac
            ;;
        list)
            awm_list "$@" --exclude-namespace projects
            ;;
        status)
            local status_session=""
            _cmd_awm_extract_session status_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            if [[ -z "$status_session" && -n "${1:-}" && "${1:0:2}" != "--" ]]; then
                status_session="$1"
                shift
            fi
            local status_target="${status_session:-$_AWM_SESSION_ID}"
            _cmd_awm_reject_project_session "$status_target" || return 1
            awm_status "$status_target"
            ;;
        doctor)
            local doctor_session=""
            _cmd_awm_extract_session doctor_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            if [[ -z "$doctor_session" && -n "${1:-}" && "${1:0:2}" != "--" ]]; then
                doctor_session="$1"
                shift
            fi
            local doctor_target="${doctor_session:-$_AWM_SESSION_ID}"
            _cmd_awm_reject_project_session "$doctor_target" || return 1
            awm_doctor "$doctor_target"
            ;;
        export)
            local export_session=""
            _cmd_awm_extract_session export_session "$@"
            set -- "${CMD_AWM_ARGS[@]}"
            _cmd_awm_require_session "$export_session" || return 1
            awm_export "${1:-}"
            ;;
        inspect)
            if [[ -z "${1:-}" ]]; then
                echo "Usage: mainframe awm inspect <session_id>"
                return 1
            fi
            _cmd_awm_reject_project_session "$1" || return 1
            awm_resume "$1" >/dev/null || return 1
            printf '{"status":%s,"summary":%s,"discoveries":%s}\n' \
                "$(awm_status "$1")" \
                "$(awm_summary)" \
                "$(awm_recent discoveries 10)"
            ;;
        migrate)
            if [[ "${1:-}" == "--all" ]]; then
                _cmd_awm_migrate_non_project_all
            else
                _cmd_awm_reject_project_session "${1:-$_AWM_SESSION_ID}" || return 1
                awm_migrate "$@"
            fi
            ;;
        *)
            _cmd_awm_help
            return 1
            ;;
    esac
}

# =============================================================================
# QUICKREF - Compact function signatures for AI agents
# =============================================================================

# List available library names (derived from lib/*.sh filenames)
_quickref_list_libraries() {
    local lib_dir="${MAINFRAME_ROOT}/lib"
    local f name
    for f in "$lib_dir"/*.sh; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f" .sh)"
        # Skip common.sh as it is the loader, not a standalone library
        [[ "$name" == "common" ]] && continue
        printf '%s\n' "$name"
    done | sort
}

# Extract compact signatures from a single library file
# Parses function declarations and preceding Usage/returns comments
_quickref_extract() {
    local lib_file="$1"

    # Use awk to pair Usage comments with function names
    awk '
    BEGIN { usage = ""; returns = "" }

    # Capture "# Usage: ..." lines (last one before function wins)
    /^# Usage:/ {
        sub(/^# Usage: */, "")
        usage = $0
        next
    }

    # Capture "@returns:" or "@returns-type:" annotations
    /^# @returns(-type)?:/ {
        sub(/^# @returns(-type)?: */, "")
        returns = $0
        next
    }

    # Capture "# Returns: ..." lines (simpler format)
    /^# Returns:/ {
        sub(/^# Returns: */, "")
        returns = $0
        next
    }

    # Match function declarations: name() { or function name {
    /^[a-zA-Z_][a-zA-Z0-9_]*\(\)/ {
        fname = $0
        sub(/\(\).*/, "", fname)
        # Skip internal functions (prefixed with _)
        if (fname ~ /^_/) { usage = ""; returns = ""; next }
        _emit(fname)
        next
    }
    /^function [a-zA-Z_][a-zA-Z0-9_]*/ {
        fname = $2
        if (fname ~ /^_/) { usage = ""; returns = ""; next }
        _emit(fname)
        next
    }

    # Reset on non-comment, non-blank lines that are not function defs
    /^[^#]/ && !/^[[:space:]]*$/ && !/^[a-zA-Z_][a-zA-Z0-9_]*\(\)/ && !/^function / {
        usage = ""
        returns = ""
    }

    function _emit(name) {
        if (usage != "") {
            # Convert usage to compact sig: fname "arg1" "arg2" -> fname(arg1, arg2)
            sig = usage
            # Remove leading function name from usage if present
            if (index(sig, name) == 1) {
                sig = substr(sig, length(name) + 1)
            }
            # Trim leading whitespace
            gsub(/^[[:space:]]+/, "", sig)
            # Convert quoted args to compact form
            gsub(/"/, "", sig)
            # Wrap in parens if not already
            if (substr(sig, 1, 1) != "(") {
                gsub(/[[:space:]]+/, ", ", sig)
                sig = "(" sig ")"
            }
            # Remove trailing empty parens for no-arg functions
            if (sig == "()") sig = "()"
        } else {
            sig = "()"
        }

        if (returns != "") {
            printf "%s%s -> %s\n", name, sig, returns
        } else {
            printf "%s%s\n", name, sig
        }

        usage = ""
        returns = ""
    }
    ' "$lib_file"
}

cmd_quickref() {
    local arg="${1:-}"
    local arg2="${2:-}"
    local lib_dir="${MAINFRAME_ROOT}/lib"

    if [[ -z "$arg" ]]; then
        echo "Usage: mainframe quickref <library>"
        echo "       mainframe quickref --list         List available libraries"
        echo "       mainframe quickref --all          Show all functions (compact)"
        echo "       mainframe quickref --search TERM  Search all functions"
        echo "       mainframe quickref --json         Output FUNCTIONS.json path"
        return 1
    fi

    case "$arg" in
        --list|-l)
            echo "Available libraries:"
            _quickref_list_libraries
            ;;
        --search|-s)
            if [[ -z "$arg2" ]]; then
                echo "Usage: mainframe quickref --search <term>"
                return 1
            fi
            local lib_name lib_file
            while IFS= read -r lib_name; do
                lib_file="${lib_dir}/${lib_name}.sh"
                local output
                output=$(_quickref_extract "$lib_file" | grep -i "$arg2" || true)
                if [[ -n "$output" ]]; then
                    printf '## %s\n' "$lib_name"
                    printf '%s\n\n' "$output"
                fi
            done < <(_quickref_list_libraries)
            ;;
        --json|-j)
            local json_file="${MAINFRAME_ROOT}/FUNCTIONS.json"
            if [[ -f "$json_file" ]]; then
                echo "$json_file"
            else
                echo "FUNCTIONS.json not found at: $json_file"
                return 1
            fi
            ;;
        --all|-a)
            local lib_name lib_file
            while IFS= read -r lib_name; do
                lib_file="${lib_dir}/${lib_name}.sh"
                local output
                output=$(_quickref_extract "$lib_file")
                if [[ -n "$output" ]]; then
                    printf '## %s\n' "$lib_name"
                    printf '%s\n\n' "$output"
                fi
            done < <(_quickref_list_libraries)
            ;;
        *)
            # Treat as library name
            local lib_file="${lib_dir}/${arg}.sh"
            if [[ ! -f "$lib_file" ]]; then
                # Also check common.sh for core functions
                if [[ "$arg" == "common" || "$arg" == "core" ]]; then
                    lib_file="${lib_dir}/common.sh"
                else
                    echo "Library not found: $arg"
                    echo ""
                    echo "Available libraries:"
                    _quickref_list_libraries
                    return 1
                fi
            fi
            printf '## %s\n' "$arg"
            _quickref_extract "$lib_file"
            ;;
    esac
}

# =============================================================================
# FZF - Interactive fuzzy finder for functions
# =============================================================================

cmd_fzf() {
    local filter="${1:-}"
    local json_file="${MAINFRAME_ROOT}/FUNCTIONS.json"

    # Check dependencies
    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is not installed."
        echo ""
        echo "Install with:"
        echo "  Ubuntu/Debian: sudo apt install fzf"
        echo "  macOS:         brew install fzf"
        echo "  Arch:          sudo pacman -S fzf"
        return 1
    fi

    if [[ ! -f "$json_file" ]]; then
        echo "Error: FUNCTIONS.json not found at: $json_file"
        echo "Run 'make docs' to generate function documentation."
        return 1
    fi

    # Build function list with library info
    local func_list
    if [[ -n "$filter" ]]; then
        # Filter by library name
        func_list=$(jq -r --arg lib "$filter" '
            .libraries[$lib] // empty |
            .functions | to_entries[] |
            "\(.key)\t\($lib)\t\(.value.signature // "()")\t\(.value.description // "No description")"
        ' "$json_file" 2>/dev/null)

        if [[ -z "$func_list" ]]; then
            echo "Library '$filter' not found."
            echo ""
            echo "Available libraries:"
            jq -r '.libraries | keys[]' "$json_file" | sort | column
            return 1
        fi
    else
        # All functions
        func_list=$(jq -r '
            .libraries | to_entries[] |
            .key as $lib |
            .value.functions | to_entries[] |
            "\(.key)\t\($lib)\t\(.value.signature // "()")\t\(.value.description // "No description")"
        ' "$json_file" 2>/dev/null)
    fi

    # Create preview script
    local preview_cmd
    preview_cmd="echo {} | cut -f1 | xargs -I{} ${MAINFRAME_ROOT}/bin/mainframe help {}"

    # Run fzf with preview
    local selected
    selected=$(echo "$func_list" | \
        fzf --delimiter='\t' \
            --with-nth=1,2 \
            --preview="$preview_cmd" \
            --preview-window=right:60%:wrap \
            --header="MAINFRAME Functions (${filter:-all libraries}) | Enter=show help | Esc=exit" \
            --prompt="Function> " \
            --height=80% \
            --layout=reverse \
            --info=inline \
            --bind="enter:execute(${MAINFRAME_ROOT}/bin/mainframe help {1})+abort" \
        2>/dev/null || true)

    # If user pressed Esc without selecting, just exit cleanly
    if [[ -z "$selected" ]]; then
        return 0
    fi

    # Extract function name and show help
    local func_name
    func_name=$(echo "$selected" | cut -f1)
    if [[ -n "$func_name" ]]; then
        cmd_help "$func_name"
    fi
}

# =============================================================================
# EXPLORE - TUI browser using dialog/whiptail
# =============================================================================

cmd_explore() {
    local json_file="${MAINFRAME_ROOT}/FUNCTIONS.json"
    local dialog_cmd=""

    # Check for dialog or whiptail
    if command -v dialog &>/dev/null; then
        dialog_cmd="dialog"
    elif command -v whiptail &>/dev/null; then
        dialog_cmd="whiptail"
    else
        echo "Error: Neither 'dialog' nor 'whiptail' is installed."
        echo ""
        echo "Install with:"
        echo "  Ubuntu/Debian: sudo apt install dialog"
        echo "  macOS:         brew install dialog"
        echo "  Arch:          sudo pacman -S dialog"
        return 1
    fi

    if [[ ! -f "$json_file" ]]; then
        echo "Error: FUNCTIONS.json not found at: $json_file"
        echo "Run 'make docs' to generate function documentation."
        return 1
    fi

    # Get terminal dimensions
    local term_height term_width
    term_height=$(tput lines 2>/dev/null || echo 24)
    term_width=$(tput cols 2>/dev/null || echo 80)
    local menu_height=$((term_height - 10))
    [[ $menu_height -lt 10 ]] && menu_height=10

    # Main loop
    while true; do
        # Build library menu
        local libs_json
        libs_json=$(jq -r '
            .libraries | to_entries[] |
            "\(.key)\n\(.value.description // "No description" | .[0:50])"
        ' "$json_file" 2>/dev/null)

        # Convert to menu items array
        local menu_items=()
        while IFS= read -r lib_name && IFS= read -r lib_desc; do
            menu_items+=("$lib_name" "$lib_desc")
        done <<< "$libs_json"

        # Show library selection menu
        local selected_lib
        selected_lib=$("$dialog_cmd" \
            --title "MAINFRAME Function Explorer" \
            --menu "Select a library to browse functions:" \
            "$term_height" "$term_width" "$menu_height" \
            "${menu_items[@]}" \
            3>&1 1>&2 2>&3) || break

        # If no selection (user cancelled), exit
        [[ -z "$selected_lib" ]] && break

        # Show functions in selected library
        _explore_library "$dialog_cmd" "$json_file" "$selected_lib" "$term_height" "$term_width" "$menu_height"
    done

    # Clear screen after dialog
    clear
}

# Helper: Browse functions within a library
_explore_library() {
    local dialog_cmd="$1"
    local json_file="$2"
    local lib_name="$3"
    local term_height="$4"
    local term_width="$5"
    local menu_height="$6"

    while true; do
        # Build function menu for this library
        local funcs_json
        funcs_json=$(jq -r --arg lib "$lib_name" '
            .libraries[$lib].functions | to_entries[] |
            "\(.key)\n\(.value.description // "No description" | .[0:50])"
        ' "$json_file" 2>/dev/null)

        if [[ -z "$funcs_json" ]]; then
            "$dialog_cmd" --title "Error" --msgbox "No functions found in library '$lib_name'" 8 50
            return
        fi

        # Convert to menu items array
        local func_items=()
        while IFS= read -r func_name && IFS= read -r func_desc; do
            func_items+=("$func_name" "$func_desc")
        done <<< "$funcs_json"

        # Show function selection menu
        local selected_func
        selected_func=$("$dialog_cmd" \
            --title "Library: $lib_name" \
            --menu "Select a function to view details:" \
            "$term_height" "$term_width" "$menu_height" \
            "${func_items[@]}" \
            3>&1 1>&2 2>&3) || return

        # If no selection, go back to library menu
        [[ -z "$selected_func" ]] && return

        # Show function details
        _explore_function_details "$dialog_cmd" "$json_file" "$lib_name" "$selected_func" "$term_height" "$term_width"
    done
}

# Helper: Show function details in a message box
_explore_function_details() {
    local dialog_cmd="$1"
    local json_file="$2"
    local lib_name="$3"
    local func_name="$4"
    local term_height="$5"
    local term_width="$6"

    # Extract function details
    local details
    details=$(jq -r --arg lib "$lib_name" --arg func "$func_name" '
        .libraries[$lib].functions[$func] |
        "FUNCTION: \($func)\n" +
        "LIBRARY: \($lib)\n" +
        "SIGNATURE: \(.signature // "()")\n" +
        "\n" +
        "DESCRIPTION:\n\(.description // "No description")\n" +
        "\n" +
        "RETURNS: \(.returns // "unspecified")\n" +
        (if .params and (.params | length) > 0 then
            "\nPARAMETERS:\n" + (.params | map("  \(.position). \(.name)\(if .required then " (required)" else " (optional)" end)") | join("\n"))
        else "" end) +
        (if .examples and (.examples | length) > 0 then
            "\n\nEXAMPLES:\n" + (.examples | map("  \(.)") | join("\n"))
        else "" end) +
        (if .idempotent != null then "\n\nIdempotent: \(.idempotent)" else "" end) +
        (if .pure != null then "\nPure: \(.pure)" else "" end)
    ' "$json_file" 2>/dev/null)

    # Calculate message box dimensions
    local msg_height=$((term_height - 4))
    local msg_width=$((term_width - 4))
    [[ $msg_height -lt 15 ]] && msg_height=15
    [[ $msg_width -lt 60 ]] && msg_width=60

    "$dialog_cmd" \
        --title "Function: $func_name" \
        --msgbox "$details" \
        "$msg_height" "$msg_width"
}

# =============================================================================
# MAIN DISPATCH
# =============================================================================

case "${1:-help}" in
    version|-v|--version)
        cmd_version
        ;;
    functions|funcs|list)
        cmd_functions
        ;;
    operations|ops)
        cmd_operations "${2:-all}"
        ;;
    run)
        shift
        cmd_operation "$@"
        ;;
    invoke)
        # The protected fast path above must consume this command before the
        # general runtime loads. Reaching ordinary dispatch is an invariant
        # failure, never permission to invoke through the broad shell surface.
        echo "MAINFRAME invocation denied: canonical broker dispatch was bypassed" >&2
        exit 126
        ;;
    code)
        # The protected fast path above must consume this command before the
        # general runtime loads. Reaching ordinary dispatch is fail-closed.
        echo "MAINFRAME code denied: durable control-plane dispatch was bypassed" >&2
        exit 126
        ;;
    help|info|describe)
        cmd_help "${2:-}"
        ;;
    search|find|grep)
        cmd_search "${2:-}"
        ;;
    awm)
        shift
        cmd_awm "$@"
        ;;
    work)
        shift
        source "$MAINFRAME_ROOT/lib/work.sh"
        mainframe_work "$@"
        ;;
    count)
        cmd_count
        ;;
    quickref|qr|signatures|sigs)
        cmd_quickref "${2:-}" "${3:-}"
        ;;
    fzf|fuzzy|browse)
        cmd_fzf "${2:-}"
        ;;
    explore|tui)
        cmd_explore
        ;;
    doctor|check|health)
        cmd_doctor
        ;;
    shell)
        shift
        source "$MAINFRAME_ROOT/lib/shell.sh"
        mainframe_shell "$@"
        ;;
    agent-hook|agent-gateway)
        shift
        # Normalize any launcher/runtime failure to the blocking hook code.
        # Hosts such as Codex, Claude, and Gemini use exit 2 as the blocking
        # result rather than treating every non-zero failure as a denial.
        if "$BASH" --noprofile --norc -p \
            "$MAINFRAME_ROOT/hooks/agent-gateway.sh" "$@"; then
            exit 0
        else
            hook_status=$?
            [[ "$hook_status" -eq 2 ]] || \
                echo "MAINFRAME agent gateway failed (exit=$hook_status); denying tool call" >&2
            exit 2
        fi
        ;;
    protect)
        shift
        source "$MAINFRAME_ROOT/lib/activate.sh"
        _mainframe_protect_command "$@"
        ;;
    host)
        shift
        source "$MAINFRAME_ROOT/lib/activate.sh"
        source "$MAINFRAME_ROOT/lib/launch.sh"
        source "$MAINFRAME_ROOT/lib/host_runtime.sh"
        source "$MAINFRAME_ROOT/lib/host_lifecycle.sh"
        mainframe_host "$@"
        ;;
    pi)
        shift
        source "$MAINFRAME_ROOT/lib/pi.sh"
        case "${1:-status}" in
            status)
                [[ $# -eq 0 ]] || shift
                mainframe_pi_status "$@"
                ;;
            doctor)
                shift
                mainframe_pi_doctor "$@"
                ;;
            install)
                shift
                mainframe_pi_install "$@"
                ;;
            remove)
                shift
                mainframe_pi_remove "$@"
                ;;
            restore)
                shift
                mainframe_pi_restore "$@"
                ;;
            help|-h|--help)
                printf '%s\n' \
                    'Usage: mainframe pi <status|doctor|install|remove|restore> [options]' \
                    '' \
                    '  status [--json]               Inspect package and legacy collision state' \
                    '  doctor [--json]               Diagnose exact Pi compatibility and activation' \
                    '  install --dry-run             Preview migration without changing files' \
                    '  install --yes                 Quarantine legacy resources and activate the package' \
                    '  remove --dry-run              Preview detaching the managed package source' \
                    '  remove --yes                  Detach the managed package; preserve backups/settings' \
                    '  restore --backup-id ID --dry-run  Authenticate an exact migration recovery' \
                    '  restore --backup-id ID --yes      Restore the exact pre-install snapshot' \
                    '' \
                    'After a changed install, use /reload in Pi (or restart Pi), then run /mainframe doctor.'
                ;;
            *)
                echo "Unknown Pi command: $1" >&2
                echo "Usage: mainframe pi <status|doctor|install|remove|restore> [options]" >&2
                exit 64
                ;;
        esac
        ;;
    setup)
        shift
        source "$MAINFRAME_ROOT/lib/agent_safety.sh"
        source "$MAINFRAME_ROOT/lib/activate.sh"
        source "$MAINFRAME_ROOT/lib/onboard.sh"
        source "$MAINFRAME_ROOT/lib/launch.sh"
        source "$MAINFRAME_ROOT/lib/host_runtime.sh"
        source "$MAINFRAME_ROOT/lib/setup.sh"
        mainframe_setup "$@"
        ;;
    onboard)
        shift
        source "$MAINFRAME_ROOT/lib/activate.sh"
        source "$MAINFRAME_ROOT/lib/onboard.sh"
        mainframe_onboard "$@"
        ;;
    launch)
        shift
        source "$MAINFRAME_ROOT/lib/activate.sh"
        source "$MAINFRAME_ROOT/lib/launch.sh"
        source "$MAINFRAME_ROOT/lib/host_runtime.sh"
        mainframe_launch "$@"
        ;;
    activate)
        shift
        source "$MAINFRAME_ROOT/lib/activate.sh"
        mainframe_activate "$@"
        ;;
    deactivate)
        shift
        source "$MAINFRAME_ROOT/lib/activate.sh"
        mainframe_deactivate "$@"
        ;;
    benchmark|bench)
        cmd_benchmark
        ;;
    test|tests)
        cmd_test
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    upgrade)
        shift
        cmd_upgrade "$@"
        ;;
    release)
        shift
        source "$MAINFRAME_ROOT/lib/release_readiness.sh"
        case "${1:-readiness}" in
            readiness)
                [[ $# -eq 0 ]] || shift
                _mainframe_release_readiness "$@"
                ;;
            help|-h|--help)
                _mainframe_release_readiness_usage
                ;;
            *)
                echo "Unknown release command: $1" >&2
                _mainframe_release_readiness_usage >&2
                exit 64
                ;;
        esac
        ;;
    uninstall)
        shift
        cmd_uninstall "$@"
        ;;
    new|init)
        # Keep delegated scripts on the already-verified current interpreter;
        # their /usr/bin/env shebang could otherwise fall back to Apple Bash.
        if [[ $# -eq 2 && ( "$2" == "-h" || "$2" == "--help" ) ]]; then
            exec "$BASH" --noprofile --norc -p \
                "$MAINFRAME_ROOT/bin/mainframe-new" "$2"
        fi
        exec "$BASH" --noprofile --norc -p \
            "$MAINFRAME_ROOT/bin/mainframe-new" "$@"
        ;;
    build)
        # Delegate through the already-verified current interpreter.
        shift  # Remove 'build' from args
        exec "$BASH" --noprofile --norc -p \
            "$MAINFRAME_ROOT/bin/mainframe-build" "$@"
        ;;
    -h|--help)
        show_help
        ;;
    *)
        if _find_operation "$1" >/dev/null; then
            cmd_operation "$@"
        else
            echo "Unknown command or operation: $1" >&2
            echo "" >&2
            show_help >&2
            exit 1
        fi
        ;;
esac

        ;;
    *)
        /bin/bash --noprofile --norc -p -- "$0" "$@"
        ;;
esac
