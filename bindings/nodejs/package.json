{
  "name": "mainframe-bash",
  "version": "1.0.0",
  "description": "Node.js/Bun bindings for the MAINFRAME Bash runtime",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && bun build src/index.ts --outfile dist/index.cjs --target node --format cjs && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "MAINFRAME_ROOT=../.. bun test tests",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mainframe",
    "bash",
    "shell",
    "json",
    "validation",
    "utilities",
    "bindings"
  ],
  "author": "MAINFRAME",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtwatts/mainframe.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "1.4.0",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "bun": {
      "optional": true
    }
  }
}
